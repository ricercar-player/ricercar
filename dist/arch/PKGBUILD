# Maintainer: ricercar-player
pkgname=ricercar-git
pkgver=0.7.0
pkgrel=1
pkgdesc="Bit-perfect music player and UPnP/OpenHome network receiver for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/ricercar-player/ricercar"
license=('MIT')
depends=('alsa-lib' 'fontconfig' 'libxkbcommon' 'gcc-libs' 'hicolor-icon-theme')
optdepends=('xdg-desktop-portal: folder picker for the library settings'
            'pipewire-alsa: play through the system mixer when not bit-perfect')
makedepends=('cargo' 'cargo-about' 'git')
provides=('ricercar')
conflicts=('ricercar')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.7.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --frozen --release -p ricercar-ui -p ricercar-cli -p ricercar-daemon
  dist/third-party-licenses.sh
}

check() {
  cd "$pkgname"
  cargo test --frozen --release -p ricercar-core -p ricercar-audio
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/ricercar "$pkgdir/usr/bin/ricercar"
  install -Dm755 target/release/ricercar-cli "$pkgdir/usr/bin/ricercar-cli"
  install -Dm755 target/release/ricercar-daemon "$pkgdir/usr/bin/ricercar-daemon"
  install -Dm644 dist/ricercar.desktop "$pkgdir/usr/share/applications/ricercar.desktop"
  install -Dm644 dist/ricercar.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/ricercar.svg"
  install -Dm644 dist/ricercar.service "$pkgdir/usr/lib/systemd/user/ricercar.service"
  for size in 48 128 256; do
    install -Dm644 "dist/icons/${size}x${size}/ricercar.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/ricercar.png"
  done
  install -Dm644 dist/io.github.ricercar_player.ricercar.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.ricercar_player.ricercar.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 target/THIRD-PARTY-LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES"
  install -Dm644 crates/ricercar-ui/assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 crates/ricercar-ui/assets/icons/LICENSE "$pkgdir/usr/share/licenses/$pkgname/icons-LICENSE"
}
