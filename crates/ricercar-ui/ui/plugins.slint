// Source plugins (docs/plugins.md): the generic browse page and the
// sign-in dialog. Everything a plugin sends is shown as plain text.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Button, TextField, Toggle, SectionTitle } from "widgets.slint";
import { BrowseContent } from "lists.slint";
import { PageScroll } from "pages.slint";

/// A list from a plugin (sidebar section, album, playlist, folder).
export component BrowsePage inherits PageScroll {
    title: App.br-title;
    fade-at: 40px;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;
        Text {
            text: App.br-title;
            font-family: Theme.display;
            font-size: Theme.fs-3xl;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: Theme.text;
            overflow: elide;
        }
        if App.br-sub != "": Text {
            text: App.br-sub;
            font-size: Theme.fs-md;
            color: Theme.text2;
            overflow: elide;
        }
        if App.br-tracks.length > 0: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            padding-top: 8px;
            padding-bottom: 8px;
            Button { text: @tr("Play"); icon: Icons.play-fill; primary: true; clicked => { App.br-play(false); } }
            Button { text: @tr("Shuffle"); icon: Icons.shuffle; clicked => { App.br-play(true); } }
        }
        BrowseContent {
            cards: App.br-cards;
            tracks: App.br-tracks;
            list: "browse";
            loading: App.br-loading;
            more: App.br-more;
            error: App.br-error;
            auth: App.br-auth;
            load-more => { App.br-load-more(); }
            sign-in => { App.br-sign-in(); }
        }
    }
}

/// Browser-based sign-in: the plugin gives an address, the user signs in
/// there (or on another device through the QR code) and may paste back
/// the address or code the service shows. No password goes through here.
export component SignInDialog inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { App.signin-cancel(); } }
    public function focus-input() {
        field.focus-field();
    }
    Rectangle {
        width: 460px;
        height: lay.preferred-height;
        border-radius: Theme.r-lg;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #000000b3;
        TouchArea { }
        lay := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: App.signin-title; font-size: Theme.fs-xl; font-weight: 700; color: Theme.text; }
            if App.signin-url == "": Text {
                text: @tr("Asking the plugin for a sign-in address…");
                font-size: Theme.fs-md;
                color: Theme.text2;
                wrap: word-wrap;
            }
            if App.signin-url != "": HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    width: 152px;
                    height: 152px;
                    border-radius: Theme.r-md;
                    background: #ffffff;
                    Image {
                        width: 136px;
                        height: 136px;
                        source: App.signin-qr;
                        image-rendering: pixelated;
                        accessible-role: image;
                        accessible-label: @tr("QR code of the sign-in address");
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: App.signin-instructions != "" ? App.signin-instructions : @tr("Sign in in your browser. On another device, scan the code.");
                        font-size: Theme.fs-md;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: App.signin-url;
                        font-size: Theme.fs-sm;
                        color: Theme.text2;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: @tr("Open in browser"); icon: Icons.log-in; clicked => { App.signin-open-browser(); } }
                    }
                }
            }
            if !App.signin-expects-input && App.signin-url != "": Text {
                text: @tr("This closes by itself once you are signed in. If the browser runs elsewhere, paste the address it ends on.");
                font-size: Theme.fs-sm;
                color: Theme.text3;
                wrap: word-wrap;
            }
            field := TextField {
                placeholder: @tr("Paste the address or code");
                text <=> App.signin-input;
                accepted(t) => { if t != "" { App.signin-complete(t); } }
                escape => { App.signin-cancel(); }
            }
            if App.signin-status != "": Text {
                text: App.signin-status;
                font-size: Theme.fs-sm;
                color: Theme.bad;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 6px;
                Button { text: @tr("Cancel"); clicked => { App.signin-cancel(); } }
                Button {
                    text: App.signin-busy ? @tr("Checking…") : @tr("Sign in");
                    primary: true;
                    enabled: App.signin-input != "" && !App.signin-busy;
                    clicked => { App.signin-complete(App.signin-input); }
                }
            }
        }
    }
}

component PanelRow inherits HorizontalLayout {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    min-height: 60px;
}

component Panel inherits Rectangle {
    border-radius: Theme.r-lg;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 4px;
        @children
    }
}

component Hairline inherits Rectangle {
    height: 1px;
    Rectangle { x: 16px; width: parent.width - 32px; background: Theme.line; }
}

/// Installed plugins and the community catalogue.
export component PluginsPage inherits PageScroll {
    title: @tr("Plugins");
    fade-at: 40px;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;
        Text {
            text: @tr("Plugins");
            font-family: Theme.display;
            font-size: Theme.fs-3xl;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: Theme.text;
        }
        Text {
            text: @tr("Plugins are programs made by other people. They run with your permissions and ricercar does not review them: install only plugins you trust, and check that they follow the terms of the service they use.");
            font-size: Theme.fs-md;
            color: Theme.text2;
            wrap: word-wrap;
        }

        SectionTitle { text: @tr("Installed"); }
        if App.plugin-rows.length == 0: Text {
            text: @tr("No plugins yet. Install one from the catalogue below, or declare it in config.toml.");
            font-size: Theme.fs-md;
            color: Theme.text3;
            wrap: word-wrap;
        }
        if App.plugin-rows.length > 0: Panel {
            for p[i] in App.plugin-rows: VerticalLayout {
                if i > 0: Hairline { }
                PanelRow {
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: p.name; font-size: Theme.fs-md; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text {
                            text: p.detail + " · " + p.status;
                            font-size: Theme.fs-sm;
                            color: p.state == 2 ? Theme.bad : Theme.text2;
                            wrap: word-wrap;
                        }
                    }
                    // Controls centred on the row, whatever their heights.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if p.enabled && p.auth && !p.signed-in && p.state == 0: Button {
                                text: @tr("Sign in");
                                primary: true;
                                clicked => { App.plugin-sign-in(p.id); }
                            }
                            if p.enabled && p.signed-in: Button {
                                text: @tr("Sign out");
                                clicked => { App.plugin-sign-out(p.id); }
                            }
                            if p.update: Button {
                                text: @tr("Update");
                                icon: Icons.download;
                                clicked => { App.plugin-update(p.id); }
                            }
                            Button {
                                text: @tr("Remove");
                                danger: true;
                                clicked => { App.plugin-remove(p.id); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: p.enabled;
                                    toggled(on) => { App.plugin-toggle(p.id, on); }
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-top: 12px;
            spacing: 12px;
            SectionTitle { text: @tr("Community catalogue"); horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button { text: @tr("Open the hub"); clicked => { App.open-hub(); } }
            }
        }
        Text {
            text: @tr("Entries point to their authors' repositories; nothing is hosted or checked by ricercar beyond the file's SHA-256.");
            font-size: Theme.fs-sm;
            color: Theme.text3;
            wrap: word-wrap;
        }
        TextField {
            icon: Icons.search;
            placeholder: @tr("Filter plugins");
            clearable: true;
            text <=> App.catalog-filter;
            edited(t) => { App.catalog-filter-edited(t); }
        }
        if App.catalog-status != "": Text {
            text: App.catalog-status;
            font-size: Theme.fs-md;
            color: Theme.text3;
            wrap: word-wrap;
        }
        if App.catalog-rows.length > 0: Panel {
            for c[i] in App.catalog-rows: VerticalLayout {
                if i > 0: Hairline { }
                PanelRow {
                    VerticalLayout {
                        alignment: center;
                        spacing: 3px;
                        horizontal-stretch: 1;
                        Text { text: c.name; font-size: Theme.fs-md; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text { text: c.byline; font-size: Theme.fs-sm; color: Theme.text3; overflow: elide; }
                        if c.description != "": Text { text: c.description; font-size: Theme.fs-sm; color: Theme.text2; wrap: word-wrap; }
                        if c.caps != "": Text { text: c.caps; font-size: Theme.fs-xs; color: Theme.text3; }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: end;
                            Button {
                                text: @tr("Repository");
                                clicked => { App.catalog-open-repo(c.id); }
                            }
                            if c.state == 0: Button {
                                text: @tr("Install");
                                icon: Icons.download;
                                primary: true;
                                clicked => { App.catalog-install(c.id); }
                            }
                            if c.state == 1: Text {
                                width: 150px;
                                text: @tr("Installed");
                                font-size: Theme.fs-sm;
                                color: Theme.text3;
                                vertical-alignment: center;
                            }
                            if c.state == 2: Text {
                                width: 150px;
                                text: @tr("No build for this computer");
                                font-size: Theme.fs-sm;
                                color: Theme.text3;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
