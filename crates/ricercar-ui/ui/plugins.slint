// Source plugins (docs/plugins.md): the generic browse page, the sign-in
// and settings dialogs. Everything a plugin sends is shown as plain text.

import { ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App } from "state.slint";
import { Button, IconButton, TextField, Toggle, Segmented, SectionTitle } from "widgets.slint";
import { BrowseContent } from "lists.slint";
import { PageScroll } from "pages.slint";

/// A list from a plugin (sidebar section, album, playlist, folder).
export component BrowsePage inherits PageScroll {
    title: App.br-title;
    fade-at: 40px;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;
        Text {
            text: App.br-title;
            font-family: Theme.display;
            font-size: Theme.fs-3xl;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: Theme.text;
            overflow: elide;
        }
        if App.br-sub != "": Text {
            text: App.br-sub;
            font-size: Theme.fs-md;
            color: Theme.text2;
            overflow: elide;
        }
        if App.br-tracks.length > 0: HorizontalLayout {
            spacing: 10px;
            alignment: start;
            padding-top: 8px;
            padding-bottom: 8px;
            Button { text: @tr("Play"); icon: Icons.play-fill; primary: true; clicked => { App.br-play(false); } }
            Button { text: @tr("Shuffle"); icon: Icons.shuffle; clicked => { App.br-play(true); } }
        }
        BrowseContent {
            cards: App.br-cards;
            tracks: App.br-tracks;
            list: "browse";
            loading: App.br-loading;
            more: App.br-more;
            error: App.br-error;
            auth: App.br-auth;
            load-more => { App.br-load-more(); }
            sign-in => { App.br-sign-in(); }
        }
    }
}

/// Browser-based sign-in: the plugin gives an address, the user signs in
/// there (or on another device through the QR code) and may paste back
/// the address or code the service shows. No password goes through here.
export component SignInDialog inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { App.signin-cancel(); } }
    public function focus-input() {
        field.focus-field();
    }
    Rectangle {
        width: 460px;
        height: lay.preferred-height;
        border-radius: Theme.r-lg;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #000000b3;
        TouchArea { }
        lay := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: App.signin-title; font-size: Theme.fs-xl; font-weight: 700; color: Theme.text; }
            if App.signin-url == "": Text {
                text: @tr("Asking the plugin for a sign-in address…");
                font-size: Theme.fs-md;
                color: Theme.text2;
                wrap: word-wrap;
            }
            if App.signin-url != "": HorizontalLayout {
                spacing: 16px;
                Rectangle {
                    width: 152px;
                    height: 152px;
                    border-radius: Theme.r-md;
                    background: #ffffff;
                    Image {
                        width: 136px;
                        height: 136px;
                        source: App.signin-qr;
                        image-rendering: pixelated;
                        accessible-role: image;
                        accessible-label: @tr("QR code of the sign-in address");
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    alignment: start;
                    Text {
                        text: App.signin-instructions != "" ? App.signin-instructions : @tr("Sign in in your browser. On another device, scan the code.");
                        font-size: Theme.fs-md;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Text {
                        text: App.signin-url;
                        font-size: Theme.fs-sm;
                        color: Theme.text2;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: @tr("Open in browser"); icon: Icons.log-in; clicked => { App.signin-open-browser(); } }
                    }
                }
            }
            if !App.signin-expects-input && App.signin-url != "": Text {
                text: @tr("This closes by itself once you are signed in. If the browser runs elsewhere, paste the address it ends on.");
                font-size: Theme.fs-sm;
                color: Theme.text3;
                wrap: word-wrap;
            }
            field := TextField {
                placeholder: @tr("Paste the address or code");
                text <=> App.signin-input;
                accepted(t) => { if t != "" { App.signin-complete(t); } }
                escape => { App.signin-cancel(); }
            }
            if App.signin-status != "": Text {
                text: App.signin-status;
                font-size: Theme.fs-sm;
                color: Theme.bad;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 6px;
                Button { text: @tr("Cancel"); clicked => { App.signin-cancel(); } }
                Button {
                    text: App.signin-busy ? @tr("Checking…") : @tr("Sign in");
                    primary: true;
                    enabled: App.signin-input != "" && !App.signin-busy;
                    clicked => { App.signin-complete(App.signin-input); }
                }
            }
        }
    }
}

/// A text field that hands its text over on Enter and when it loses the
/// keyboard focus (not on every key).
component CommitField inherits TextField {
    callback commit(string);
    private property <bool> focused: self.has-focus;
    changed focused => {
        if !focused { root.commit(root.text); }
    }
    accepted(t) => { root.commit(t); }
}

/// The settings a plugin declares, grouped by section. Each change applies
/// at once; refused values say why under their line.
export component PluginSettingsDialog inherits Rectangle {
    background: Theme.scrim;
    TouchArea { clicked => { App.psettings-close(); } }
    forward-focus: keys;
    // Escape closes it, wherever the focus is inside.
    keys := FocusScope {
        key-pressed(e) => {
            if e.text == Key.Escape {
                App.psettings-close();
                return accept;
            }
            reject
        }
        Rectangle {
            width: 560px;
            height: lay.preferred-height;
            border-radius: Theme.r-lg;
            background: Theme.overlay;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 16px;
            drop-shadow-color: #000000b3;
            TouchArea { }
            lay := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                Text { text: App.psettings-title; font-size: Theme.fs-xl; font-weight: 700; color: Theme.text; overflow: elide; }
                Text { text: App.psettings-note; font-size: Theme.fs-sm; color: Theme.text2; wrap: word-wrap; }
                fl := Flickable {
                    height: min(body.preferred-height, root.height - 220px);
                    content-height: body.preferred-height;
                    body := VerticalLayout {
                        width: fl.width;
                        for r[i] in App.psettings-rows: VerticalLayout {
                            if r.kind == 0: Text {
                                text: r.label;
                                font-size: Theme.fs-sm;
                                font-weight: 700;
                                color: Theme.text2;
                                height: self.preferred-height + (i > 0 ? 18px : 6px);
                                vertical-alignment: bottom;
                                overflow: elide;
                            }
                            if r.kind != 0: HorizontalLayout {
                                padding-top: 8px;
                                padding-bottom: 8px;
                                spacing: 16px;
                                min-height: 52px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text { text: r.label; font-size: Theme.fs-md; font-weight: 500; color: Theme.text; wrap: word-wrap; }
                                    if r.description != "": Text { text: r.description; font-size: Theme.fs-sm; color: Theme.text2; wrap: word-wrap; }
                                    if r.restart: Text { text: @tr("Restarts the plugin when changed."); font-size: Theme.fs-xs; color: Theme.text3; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    HorizontalLayout {
                                        alignment: end;
                                        spacing: 8px;
                                        if r.kind == 1: VerticalLayout {
                                            alignment: center;
                                            Toggle {
                                                label: r.label;
                                                checked <=> r.on;
                                                toggled(on) => { App.psettings-bool(r.key, on); }
                                            }
                                        }
                                        if r.kind == 2: CommitField {
                                            width: 220px;
                                            placeholder: r.placeholder;
                                            text <=> r.text;
                                            commit(t) => { App.psettings-text(r.key, t); }
                                            escape => { App.psettings-close(); }
                                        }
                                        if r.kind == 3: CommitField {
                                            width: 96px;
                                            placeholder: r.placeholder;
                                            text <=> r.text;
                                            commit(t) => { App.psettings-text(r.key, t); }
                                            escape => { App.psettings-close(); }
                                        }
                                        if r.kind == 3 && r.unit != "": Text {
                                            text: r.unit;
                                            font-size: Theme.fs-sm;
                                            color: Theme.text2;
                                            vertical-alignment: center;
                                        }
                                        if r.kind == 4: VerticalLayout {
                                            alignment: center;
                                            Segmented {
                                                label: r.label;
                                                options: r.options;
                                                selected <=> r.selected;
                                                changed(i) => { App.psettings-choice(r.key, i); }
                                            }
                                        }
                                        if r.kind == 5: ComboBox {
                                            width: 220px;
                                            model: r.options;
                                            current-index <=> r.selected;
                                            selected => { App.psettings-choice(r.key, self.current-index); }
                                        }
                                    }
                                }
                            }
                            if r.error != "": Text {
                                text: r.error;
                                font-size: Theme.fs-sm;
                                color: Theme.bad;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 6px;
                    Button { text: @tr("Reset to defaults"); clicked => { App.psettings-reset(); } }
                    Rectangle { horizontal-stretch: 1; }
                    Button { text: @tr("Close"); primary: true; clicked => { App.psettings-close(); } }
                }
            }
        }
    }
    init => { keys.focus(); }
}

component PanelRow inherits HorizontalLayout {
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    min-height: 60px;
}

component Panel inherits Rectangle {
    border-radius: Theme.r-lg;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 4px;
        @children
    }
}

component Hairline inherits Rectangle {
    height: 1px;
    Rectangle { x: 16px; width: parent.width - 32px; background: Theme.line; }
}

/// Installed plugins and the community catalogue.
export component PluginsPage inherits PageScroll {
    title: @tr("Plugins");
    fade-at: 40px;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;
        Text {
            text: @tr("Plugins");
            font-family: Theme.display;
            font-size: Theme.fs-3xl;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: Theme.text;
        }
        Text {
            text: @tr("Plugins are programs made by other people. They run with your permissions and ricercar does not review them: install only plugins you trust, and check that they follow the terms of the service they use.");
            font-size: Theme.fs-md;
            color: Theme.text2;
            wrap: word-wrap;
        }

        SectionTitle { text: @tr("Installed"); }
        if App.plugin-rows.length == 0: Text {
            text: @tr("No plugins yet. Install one from the catalogue below, or declare it in config.toml.");
            font-size: Theme.fs-md;
            color: Theme.text3;
            wrap: word-wrap;
        }
        if App.plugin-rows.length > 0: Panel {
            for p[i] in App.plugin-rows: VerticalLayout {
                if i > 0: Hairline { }
                PanelRow {
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: p.name; font-size: Theme.fs-md; font-weight: 600; color: Theme.text; overflow: elide; }
                        Text {
                            text: p.detail + " · " + p.status;
                            font-size: Theme.fs-sm;
                            color: p.state == 2 ? Theme.bad : Theme.text2;
                            wrap: word-wrap;
                        }
                    }
                    // Controls centred on the row, whatever their heights.
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if p.enabled && p.auth && !p.signed-in && p.state == 0: Button {
                                text: @tr("Sign in");
                                primary: true;
                                clicked => { App.plugin-sign-in(p.id); }
                            }
                            if p.enabled && p.signed-in: Button {
                                text: @tr("Sign out");
                                clicked => { App.plugin-sign-out(p.id); }
                            }
                            if p.has-settings: VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.settings;
                                    enabled: p.running;
                                    tooltip: p.running ? @tr("Plugin settings") : @tr("Plugin settings (available while the plugin runs)");
                                    clicked => { App.plugin-settings(p.id); }
                                }
                            }
                            if p.update: Button {
                                text: @tr("Update");
                                icon: Icons.download;
                                clicked => { App.plugin-update(p.id); }
                            }
                            Button {
                                text: @tr("Remove");
                                danger: true;
                                clicked => { App.plugin-remove(p.id); }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: p.enabled;
                                    toggled(on) => { App.plugin-toggle(p.id, on); }
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding-top: 12px;
            spacing: 12px;
            SectionTitle { text: @tr("Community catalogue"); horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button { text: @tr("Open the hub"); clicked => { App.open-hub(); } }
            }
        }
        Text {
            text: @tr("Entries point to their authors' repositories; nothing is hosted or checked by ricercar beyond the file's SHA-256.");
            font-size: Theme.fs-sm;
            color: Theme.text3;
            wrap: word-wrap;
        }
        TextField {
            icon: Icons.search;
            placeholder: @tr("Filter plugins");
            clearable: true;
            text <=> App.catalog-filter;
            edited(t) => { App.catalog-filter-edited(t); }
        }
        if App.catalog-status != "": Text {
            text: App.catalog-status;
            font-size: Theme.fs-md;
            color: Theme.text3;
            wrap: word-wrap;
        }
        if App.catalog-rows.length > 0: Panel {
            for c[i] in App.catalog-rows: VerticalLayout {
                if i > 0: Hairline { }
                // Name and actions on one line; the description under them
                // at full width (wrapped text in a row does not get its
                // height, and spills onto the next rows).
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            min-width: 0px;
                            Text { text: c.name; font-size: Theme.fs-md; font-weight: 600; color: Theme.text; overflow: elide; }
                            Text { text: c.byline; font-size: Theme.fs-sm; color: Theme.text3; overflow: elide; }
                        }
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: end;
                                Button {
                                    text: @tr("Repository");
                                    clicked => { App.catalog-open-repo(c.id); }
                                }
                                if c.state == 0: Button {
                                    text: @tr("Install");
                                    icon: Icons.download;
                                    primary: true;
                                    clicked => { App.catalog-install(c.id); }
                                }
                                if c.state == 1: Text {
                                    text: @tr("Installed");
                                    font-size: Theme.fs-sm;
                                    color: Theme.text3;
                                    vertical-alignment: center;
                                }
                                if c.state == 2: Text {
                                    text: @tr("No build for this computer");
                                    font-size: Theme.fs-sm;
                                    color: Theme.text3;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if c.description != "": Text { text: c.description; font-size: Theme.fs-sm; color: Theme.text2; wrap: word-wrap; }
                    if c.caps != "": Text { text: c.caps; font-size: Theme.fs-xs; color: Theme.text3; wrap: word-wrap; }
                }
            }
        }
    }
}
