import { Theme } from "theme.slint";
import { Icons } from "icons.slint";

export component Icon inherits Image {
    in property <color> tint: Theme.text2;
    in property <length> size: 18px;
    width: size;
    height: size;
    colorize: tint;
    image-fit: contain;
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 32px;
    in property <length> icon-size: 18px;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <color> tint: active ? Theme.accent : Theme.text2;
    in property <string> tooltip;
    in property <bool> round: true;
    callback clicked();
    width: size;
    height: size;
    border-radius: round ? self.height / 2 : Theme.r-md;
    background: !enabled ? transparent : ta.pressed ? Theme.press : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; easing: ease-out; }
    accessible-role: button;
    accessible-label: tooltip;
    accessible-action-default => { clicked(); }
    Icon {
        source: icon;
        size: icon-size;
        tint: !enabled ? Theme.text3.with-alpha(0.5) : ta.has-hover && !active ? Theme.text : tint;
        animate colorize { duration: Theme.quick; }
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
    if active && round: Rectangle {
        y: parent.height - 5px;
        width: 4px;
        height: 4px;
        border-radius: 2px;
        background: Theme.accent;
    }
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> enabled: true;
    in property <bool> danger;
    callback clicked();
    height: 36px;
    min-width: lay.preferred-width;
    border-radius: self.height / 2;
    background: !enabled ? Theme.hover : primary ? (ta.pressed ? Theme.accent.darker(0.15) : ta.has-hover ? Theme.accent.brighter(0.08) : Theme.accent) : (ta.pressed ? Theme.press : ta.has-hover ? Theme.selected : Theme.hover);
    border-width: primary ? 0 : 1px;
    border-color: Theme.line;
    animate background { duration: Theme.quick; easing: ease-out; }
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    lay := HorizontalLayout {
        padding-left: icon.width > 0 ? 14px : 18px;
        padding-right: 18px;
        spacing: 8px;
        alignment: center;
        if icon.width > 0: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            size: 16px;
            tint: primary ? Theme.on-accent : danger ? Theme.bad : Theme.text;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            font-size: Theme.fs-base;
            font-weight: 600;
            color: !enabled ? Theme.text3 : primary ? Theme.on-accent : danger ? Theme.bad : Theme.text;
        }
    }
    ta := TouchArea {
        mouse-cursor: enabled ? pointer : default;
        clicked => { if enabled { root.clicked(); } }
    }
}

/// Big round play button (album headers, cards).
export component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <length> size: 52px;
    callback clicked();
    width: size;
    height: size;
    border-radius: size / 2;
    background: ta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
    drop-shadow-blur: 14px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000066;
    accessible-role: button;
    accessible-label: playing ? "Pause" : "Play";
    accessible-action-default => { clicked(); }
    Icon {
        x: (parent.width - self.width) / 2 + (playing ? 0 : size * 0.03);
        source: playing ? Icons.pause-fill : Icons.play-fill;
        size: size * 0.4;
        tint: Theme.on-accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    states [
        hover when ta.has-hover && !ta.pressed: {
            transform-scale: 1.05;
        }
    ]
    animate transform-scale { duration: Theme.quick; easing: ease-out; }
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.text2;
    in property <bool> filled;
    height: 18px;
    width: t.preferred-width + 12px;
    border-radius: 4px;
    background: filled ? tint : transparent;
    border-width: filled ? 0 : 1px;
    border-color: tint.with-alpha(0.6);
    t := Text {
        text: root.text;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.4px;
        color: filled ? Theme.on-accent : tint;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

/// Cover art with a neutral placeholder while it loads (or when there is none).
export component Cover inherits Rectangle {
    in property <image> source;
    in property <length> radius: Theme.r-md;
    in property <image> placeholder: Icons.disc-3;
    border-radius: radius;
    clip: true;
    background: Theme.raised;
    if source.width == 0: Icon {
        source: placeholder;
        size: min(parent.width, parent.height) * 0.36;
        tint: Theme.text3.with-alpha(0.55);
    }
    img := Image {
        width: 100%;
        height: 100%;
        source: root.source;
        image-fit: cover;
        opacity: source.width > 0 ? 1 : 0;
        animate opacity { duration: Theme.calm; easing: ease-out; }
    }
}

export component SectionTitle inherits HorizontalLayout {
    in property <string> text;
    in property <string> action;
    callback action-clicked();
    height: 40px;
    alignment: space-between;
    Text {
        text: root.text;
        font-size: Theme.fs-xl;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
    if action != "": Text {
        text: root.action;
        font-size: Theme.fs-sm;
        font-weight: 600;
        color: act.has-hover ? Theme.text : Theme.text2;
        vertical-alignment: center;
        act := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.action-clicked(); }
        }
    }
}

/// Thin progress/seek bar with a knob on hover; emits `seek(fraction)`.
export component SeekBar inherits Rectangle {
    in property <float> value; // 0..1
    in property <bool> enabled: true;
    in property <color> fill: Theme.text;
    in property <color> hover-fill: Theme.accent;
    in property <length> thickness: 4px;
    out property <bool> dragging: ta.pressed;
    out property <float> preview: ta.pressed || ta.has-hover ? max(0, min(1, ta.mouse-x / self.width)) : value;
    callback seek(float);
    callback moved(float);
    height: 16px;
    private property <float> shown: ta.pressed ? max(0, min(1, ta.mouse-x / self.width)) : value;
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: ta.has-hover || ta.pressed ? thickness + 2px : thickness;
        border-radius: self.height / 2;
        background: Theme.line-strong;
        animate height { duration: Theme.quick; }
        Rectangle {
            x: 0;
            width: parent.width * shown;
            height: 100%;
            border-radius: parent.border-radius;
            background: enabled && (ta.has-hover || ta.pressed) ? hover-fill : fill;
        }
    }
    if enabled && (ta.has-hover || ta.pressed): Rectangle {
        x: parent.width * shown - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000080;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        moved => {
            if self.pressed { root.moved(max(0, min(1, self.mouse-x / root.width))); }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.seek(max(0, min(1, self.mouse-x / root.width)));
            }
        }
        scroll-event(e) => {
            root.seek(max(0, min(1, root.value + (e.delta-y > 0 ? 0.05 : -0.05))));
            accept
        }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: checked ? Theme.accent : Theme.line-strong;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: Theme.quick; }
    accessible-role: checkbox;
    accessible-checked: checked;
    accessible-action-default => { checked = !checked; toggled(checked); }
    Rectangle {
        x: root.checked ? root.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? Theme.on-accent : Theme.text;
        animate x { duration: Theme.quick; easing: ease-out; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// A row of mutually exclusive options.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);
    height: 32px;
    width: lay.preferred-width;
    border-radius: self.height / 2;
    background: Theme.hover;
    lay := HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt[i] in options: Rectangle {
            width: t.preferred-width + 24px;
            border-radius: self.height / 2;
            background: i == root.selected ? Theme.raised : ta.has-hover ? Theme.hover : transparent;
            drop-shadow-blur: i == root.selected ? 3px : 0;
            drop-shadow-color: #0000004d;
            animate background { duration: Theme.quick; }
            t := Text {
                text: opt;
                font-size: Theme.fs-sm;
                font-weight: 600;
                color: i == root.selected ? Theme.text : Theme.text2;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
            ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = i;
                    root.changed(i);
                }
            }
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <image> icon;
    in property <bool> password;
    in property <bool> clearable;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    callback escape();
    height: 36px;
    border-radius: Theme.r-md;
    background: input.has-focus ? Theme.raised : Theme.hover;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent.with-alpha(0.7) : Theme.line;
    animate border-color, background { duration: Theme.quick; }
    public function focus-field() {
        input.focus();
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        if icon.width > 0: Icon {
            y: (parent.height - self.height) / 2;
            source: icon;
            size: 16px;
            tint: input.has-focus ? Theme.text : Theme.text3;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.text == "": Text {
                x: 0;
                width: 100%;
                text: root.placeholder;
                color: Theme.text3;
                font-size: Theme.fs-base;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                width: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: Theme.fs-base;
                vertical-alignment: center;
                selection-background-color: Theme.accent.with-alpha(0.35);
                selection-foreground-color: Theme.text;
                input-type: root.password ? InputType.password : InputType.text;
                single-line: true;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.escape();
                        return accept;
                    }
                    reject
                }
            }
        }
        if clearable && root.text != "": IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.x;
            size: 22px;
            icon-size: 14px;
            clicked => {
                root.text = "";
                root.edited("");
            }
        }
    }
}

/// Square album tile: cover, title, artist; play button on hover.
export component AlbumTile inherits Rectangle {
    in property <image> cover;
    in property <string> title;
    in property <string> subtitle;
    in property <bool> hires;
    in property <bool> current;
    in property <bool> playing;
    in property <length> size: 176px;
    callback open();
    callback play();
    callback menu(length, length);
    width: size;
    height: size + 52px;
    accessible-role: button;
    accessible-label: title + ", " + subtitle;
    accessible-action-default => { open(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.menu(self.mouse-x, self.mouse-y);
            }
        }
    }
    Cover {
        x: 0;
        y: 0;
        width: root.size;
        height: root.size;
        source: root.cover;
        drop-shadow-blur: ta.has-hover ? 18px : 8px;
        drop-shadow-offset-y: ta.has-hover ? 8px : 3px;
        drop-shadow-color: #00000059;
        animate drop-shadow-blur, drop-shadow-offset-y { duration: Theme.calm; easing: ease-out; }
        if hires: Rectangle {
            x: 8px;
            y: 8px;
            width: hb.width;
            height: hb.height;
            border-radius: 4px;
            background: #000000a0;
            hb := Badge {
                text: "HI-RES";
                tint: #f0cf8a;
            }
        }
        Rectangle {
            opacity: ta.has-hover || play-ta.has-hover || (root.current && root.playing) ? 1 : 0;
            animate opacity { duration: Theme.quick; }
            x: parent.width - self.width - 10px;
            y: parent.height - self.height - 10px;
            width: 44px;
            height: 44px;
            border-radius: 22px;
            background: play-ta.pressed ? Theme.accent.darker(0.15) : Theme.accent;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000080;
            Icon {
                x: (parent.width - self.width) / 2 + (root.current && root.playing ? 0 : 1px);
                source: root.current && root.playing ? Icons.pause-fill : Icons.play-fill;
                size: 18px;
                tint: Theme.on-accent;
            }
            play-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
        }
    }
    Text {
        x: 0;
        y: root.size + 10px;
        width: root.size;
        height: 20px;
        text: root.title;
        font-size: Theme.fs-md;
        font-weight: 600;
        color: root.current ? Theme.accent : Theme.text;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: 0;
        y: root.size + 30px;
        width: root.size;
        height: 18px;
        text: root.subtitle;
        font-size: Theme.fs-sm;
        color: Theme.text2;
        overflow: elide;
        vertical-alignment: center;
    }
}

/// Round artist tile (uses an album cover of the artist).
export component ArtistTile inherits Rectangle {
    in property <image> cover;
    in property <string> name;
    in property <string> subtitle;
    in property <length> size: 160px;
    callback open();
    width: size;
    height: size + 48px;
    accessible-role: button;
    accessible-label: name;
    accessible-action-default => { open(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    Rectangle {
        width: root.size;
        height: root.size;
        y: 0;
        border-radius: self.width / 2;
        background: ta.has-hover ? Theme.selected : transparent;
        animate background { duration: Theme.quick; }
        Cover {
            width: parent.width - 12px;
            height: parent.height - 12px;
            radius: self.width / 2;
            source: root.cover;
            placeholder: Icons.users-round;
        }
    }
    VerticalLayout {
        y: root.size + 8px;
        height: 40px;
        spacing: 2px;
        Text {
            text: root.name;
            font-size: Theme.fs-md;
            font-weight: 600;
            color: Theme.text;
            horizontal-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.subtitle;
            font-size: Theme.fs-sm;
            color: Theme.text2;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
}

/// Animated "now playing" equalizer glyph for the current row.
export component NowBars inherits Rectangle {
    in property <bool> animated;
    width: 14px;
    height: 14px;
    for i in 3: Rectangle {
        x: i * 5px;
        width: 3px;
        border-radius: 1px;
        background: Theme.accent;
        height: animated ? (parent.height * (0.35 + 0.65 * abs(sin((animation-tick() / 1ms * (0.004 + i * 0.0017) + i * 1.3) * 1rad)))) : parent.height * (0.4 + i * 0.2);
        y: parent.height - self.height;
    }
}
