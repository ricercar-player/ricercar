                text: @tr("Shuffle");
                icon: Icons.shuffle;
                clicked => { App.album-action(App.ge-name, "genre-shuffle"); }
            }
        }
        AlbumFlow { albums: App.ge-albums; playing-album: App.album-id; }
    }
}

// ------------------------------------------------------------------ favorites

export component FavoritesPage inherits PageScroll {
    title: @tr("Favorites");
    fade-at: 40px;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 16px;
            Text {
                text: @tr("Favorites");
                font-family: Theme.display;
                font-size: Theme.fs-3xl;
                font-weight: 800;
                letter-spacing: -0.8px;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if App.fav-tracks.length > 0: Button {
                y: (parent.height - self.height) / 2;
                text: @tr("Play");
                icon: Icons.play-fill;
                primary: true;
                clicked => { App.track-activate("fav", 0); }
            }
        }
        if App.fav-albums.length == 0 && App.fav-tracks.length == 0: EmptyState {
            icon: Icons.heart;
            title: @tr("Nothing here yet");
            body: @tr("Tap the heart on an album or a track to keep it here.");
        }
        if App.fav-albums.length > 0: VerticalLayout {
            spacing: 12px;
            padding-top: 8px;
            SectionTitle { text: @tr("Albums"); }
            AlbumShelf { albums: App.fav-albums; playing-album: App.album-id; }
        }
        if App.fav-tracks.length > 0: VerticalLayout {
            spacing: 8px;
            padding-top: 8px;
            SectionTitle { text: @tr("Tracks"); }
            TrackTable { rows: App.fav-tracks; list: "fav"; show-cover: true; }
        }
    }
}

// ------------------------------------------------------------------ playlist

export component PlaylistPage inherits PageScroll {
    title: App.pl-name;
    fade-at: 220px;
    callback rename();
    callback delete();
    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        padding-top: 8px;
        spacing: 28px;
        height: 240px;
        Cover {
            width: 200px;
            height: 200px;
            source: App.pl-cover;
            placeholder: Icons.list-music;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: #00000066;
        }
        VerticalLayout {
            alignment: end;
            spacing: 8px;
            padding-bottom: 40px;
            Text { text: @tr("Playlist"); font-size: Theme.fs-sm; font-weight: 600; color: Theme.text2; }
            Text {
                text: App.pl-name;
                font-family: Theme.display;
                font-size: Theme.fs-hero;
                font-weight: 800;
                letter-spacing: -1.2px;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: @tr("{n} track" | "{n} tracks" % App.pl-count) + (App.pl-duration != "" ? " · " + App.pl-duration : "");
                font-size: Theme.fs-md;
                color: Theme.text2;
            }
        }
    }
    HorizontalLayout {
        padding-left: 32px;
        padding-bottom: 16px;
        spacing: 12px;
        alignment: start;
        PlayButton { clicked => { App.playlist-play(App.pl-id, false); } }
        IconButton { y: (parent.height - self.height) / 2; size: 44px; icon-size: 22px; icon: Icons.shuffle; tooltip: @tr("Shuffle"); clicked => { App.playlist-play(App.pl-id, true); } }
        IconButton { y: (parent.height - self.height) / 2; size: 44px; icon-size: 20px; icon: Icons.pencil; tooltip: @tr("Rename"); clicked => { root.rename(); } }
        IconButton { y: (parent.height - self.height) / 2; size: 44px; icon-size: 20px; icon: Icons.upload; tooltip: @tr("Export as M3U"); clicked => { App.playlist-export(App.pl-id); } }
        IconButton { y: (parent.height - self.height) / 2; size: 44px; icon-size: 20px; icon: Icons.trash; tooltip: @tr("Delete playlist"); clicked => { root.delete(); } }
    }
    if App.pl-tracks.length == 0: EmptyState {
        icon: Icons.list-plus;
        title: @tr("This playlist is empty");
        body: @tr("Right-click any track and choose “Add to playlist”.");
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        if App.pl-tracks.length > 0: TrackTable { rows: App.pl-tracks; list: "playlist"; show-cover: true; }
    }
}

// ------------------------------------------------------------------ search

export component SearchPage inherits PageScroll {
    title: @tr("Search");
    fade-at: 40px;
    VerticalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 12px;
        Text {
            text: App.search-text == "" ? @tr("Search") : @tr("Results for “{}”", App.search-text);
            font-family: Theme.display;
            font-size: Theme.fs-3xl;
            font-weight: 800;
            letter-spacing: -0.8px;
            color: Theme.text;
            overflow: elide;
        }
        if App.search-text != "" && App.s-tracks.length == 0 && App.s-albums.length == 0 && App.s-artists.length == 0: EmptyState {
            icon: Icons.search;
            title: @tr("No results");
            body: @tr("Nothing in your library matches. Check the spelling, or try fewer words.");
        }
        if App.s-artists.length > 0: VerticalLayout {
            spacing: 8px;
            padding-top: 8px;
            SectionTitle { text: @tr("Artists"); }
            Flickable {
                height: 208px;
                content-width: App.s-artists.length * 170px;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    for a in App.s-artists: ArtistTile {
                        size: 160px;
                        cover: a.cover;
                        name: a.name;
                        subtitle: @tr("{n} album" | "{n} albums" % a.albums);
                        open => { App.artist-activate(a.name); }
                    }
                }
            }
        }
        if App.s-tracks.length > 0: VerticalLayout {
            spacing: 8px;
            padding-top: 8px;
            SectionTitle { text: @tr("Tracks"); }
            TrackTable { rows: App.s-tracks; list: "search"; show-cover: true; header: false; limit: 12; }
        }
        if App.s-albums.length > 0: VerticalLayout {
            spacing: 12px;
            padding-top: 16px;
            SectionTitle { text: @tr("Albums"); }
            AlbumFlow { albums: App.s-albums; playing-album: App.album-id; }
        }
    }
}
