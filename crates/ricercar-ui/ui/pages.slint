// ------------------------------------------------------------------ genres

export component GenresPage inherits PageScroll {
    title: @tr("Genres");
    private property <length> gap: 16px;
    private property <int> cols: max(1, floor((self.width - 64px + gap) / (200px + gap)));
    private property <length> tile: (self.width - 64px - (cols - 1) * gap) / cols;
    Text {
        x: 32px;
        text: @tr("Genres");
        font-family: Theme.display;
        font-size: Theme.fs-3xl;
        font-weight: 800;
        letter-spacing: -0.8px;
        color: Theme.text;
    }
    Rectangle { height: 20px; }
    if App.genres.length == 0: EmptyState {
        icon: Icons.tag;
        title: @tr("No genres");
        body: @tr("Genres come from the GENRE tag of your files.");
    }
    Rectangle {
        height: ceil(App.genres.length / cols) * (110px + gap);
        for g[i] in App.genres: Rectangle {
            x: 32px + mod(i, cols) * (tile + gap);
            y: floor(i / cols) * (110px + gap);
            width: tile;
            height: 110px;
            border-radius: Theme.r-lg;
            clip: true;
            background: g.tint;
            Rectangle {
                background: @linear-gradient(135deg, #00000000 0%, #0000004d 100%);
            }
            Text {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                text: g.name;
                font-size: Theme.fs-xl;
                font-weight: 800;
                color: #ffffff;
                wrap: word-wrap;
            }
            Text {
                x: 16px;
                y: parent.height - 30px;
                text: @tr("{n} album" | "{n} albums" % g.albums);
                font-size: Theme.fs-sm;
                font-weight: 600;
                color: #ffffffcc;
            }
            gta := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.navigate(Page.genre, g.name); }
            }
            transform-scale: gta.has-hover ? 1.02 : 1;
            animate transform-scale { duration: Theme.quick; easing: ease-out; }
        }
    }
}

export component GenrePage inherits PageScroll {
