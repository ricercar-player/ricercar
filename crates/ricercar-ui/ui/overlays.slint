import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { App, QueueRow, MenuEntry, ItemAction, Page } from "state.slint";
import { Icon, IconButton, Button, Cover, Segmented, TextField, NowBars, Badge } from "widgets.slint";
import { TrackMenu } from "lists.slint";

// ------------------------------------------------------------------ queue

component QueueLine inherits Rectangle {
    in property <QueueRow> item;
    in property <int> index;
    in property <length> row-h: 58px;
    out property <bool> dragging: grip.pressed;
    // the remove button takes the hover from `ta` when pointed at
    private property <bool> btn-hot;
    private property <bool> more-hot;
    private property <bool> hot: ta.has-hover || grip.has-hover || btn-hot || more-hot;
    callback drop-at(int, int);
    height: row-h;
    border-radius: Theme.r-md;
    background: item.current ? Theme.accent-soft : hot || grip.pressed ? Theme.hover : transparent;
    z: grip.pressed ? 10 : 0;
    // Drop indicator: a bar where the dragged row will land.
    private property <int> drag-steps: grip.pressed ? round((grip.mouse-y - grip.pressed-y) / row-h) : 0;
    if drag-steps != 0: Rectangle {
        y: drag-steps > 0 ? (drag-steps + 1) * root.row-h - 1px : drag-steps * root.row-h - 1px;
        height: 2px;
        background: Theme.accent;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.queue-play(root.item.id); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.open-menu(root.absolute-position.x + self.mouse-x, root.absolute-position.y + self.mouse-y);
            }
        }
    }
    // The entry's menu (go to its album or artist, remove it).
    function open-menu(x: length, y: length) {
        TrackMenu.list = "queue";
        TrackMenu.track-plugin = false;
        TrackMenu.index = root.item.id;
        TrackMenu.x = x;
        TrackMenu.y = y;
        TrackMenu.serial += 1;
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 10px;
        Rectangle {
            width: 18px;
            opacity: hot || grip.pressed ? 1 : 0;
            Icon { source: Icons.grip-vertical; size: 16px; tint: Theme.text3; }
            grip := TouchArea {
                mouse-cursor: grab;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                        let steps = round((self.mouse-y - self.pressed-y) / root.row-h);
                        if steps != 0 { root.drop-at(root.index, root.index + steps); }
                    }
                }
            }
        }
        Cover {
            y: (parent.height - self.height) / 2;
            width: 42px;
            height: 42px;
            radius: Theme.r-sm;
            source: item.cover;
            placeholder: Icons.music;
            if item.current: Rectangle {
                background: #00000080;
                NowBars { animated: App.playing; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text { text: item.title; font-size: Theme.fs-md; font-weight: 500; color: item.current ? Theme.accent : Theme.text; overflow: elide; }
            Text { text: item.artist; font-size: Theme.fs-sm; color: Theme.text2; overflow: elide; }
        }
        // The duration and, while hovered, the buttons share one fixed slot:
        // nothing moves under the pointer, and the buttons always exist so
        // moving onto them never makes them flicker away.
        Rectangle {
            width: 68px;
            Text {
                visible: !hot;
                width: parent.width;
                height: parent.height;
                text: item.dur;
                font-size: Theme.fs-sm;
                color: Theme.text3;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            HorizontalLayout {
                visible: hot;
                alignment: end;
                spacing: 4px;
                IconButton {
                    y: (parent.height - self.height) / 2;
                    size: 32px;
                    icon-size: 16px;
                    icon: Icons.ellipsis;
                    tooltip: @tr("More");
                    changed has-hover => { root.more-hot = self.has-hover; }
                    clicked => { root.open-menu(self.absolute-position.x, self.absolute-position.y + self.height); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    visible: !item.current;
                    size: 32px;
                    icon-size: 16px;
                    icon: Icons.x;
                    tooltip: @tr("Remove");
                    changed has-hover => { root.btn-hot = self.has-hover; }
                    clicked => { App.queue-remove(root.item.id); }
                }
            }
        }
    }
}

export component QueueList inherits Rectangle {
    in property <bool> compact;
    private property <int> first-upcoming: App.queue-current + 1;
    private property <int> last-index: App.queue.length > 0 ? App.queue[App.queue.length - 1].index : 0;
    // Upcoming rows are virtualized; report the ones on screen for covers.
    private property <int> first: max(0, floor(-lv.content-y / 58px));
    private property <string> window-key: first + ":" + lv.height / 1px + ":" + App.queue.length;
    changed window-key => {
        App.visible("queue", first, min(App.queue.length, first + ceil(lv.height / 58px) + 2));
    }
    VerticalLayout {
        spacing: 2px;
        if App.queue-has-now: Text {
            text: @tr("Now playing");
            font-size: Theme.fs-xs;
            font-weight: 700;
            letter-spacing: 0.6px;
            color: Theme.text3;
            height: 28px;
            vertical-alignment: center;
        }
        if App.queue-has-now: QueueLine {
            item: App.queue-now;
            index: App.queue-current;
            drop-at(from, to) => { App.queue-move(from, max(first-upcoming, min(last-index, to))); }
        }
        if App.queue.length > 0: Text {
            text: @tr("Next up") + " · " + App.queue-meta;
            font-size: Theme.fs-xs;
            font-weight: 700;
            letter-spacing: 0.6px;
            color: Theme.text3;
            height: 36px;
            vertical-alignment: bottom;
        }
        lv := ListView {
            vertical-stretch: 1;
            for q in App.queue: QueueLine {
                item: q;
                index: q.index;
                drop-at(from, to) => { App.queue-move(from, max(first-upcoming, min(last-index, to))); }
            }
        }
        // Continuous playback is asking the plugin for what comes next.
        if App.queue-radio-pending: Text {
            text: @tr("Finding more tracks…");
            font-size: Theme.fs-sm;
            color: Theme.text3;
            height: 32px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    if App.queue.length == 0 && !App.queue-has-now: VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 32px;
        HorizontalLayout { alignment: center; Icon { source: Icons.list-music; size: 36px; tint: Theme.text3; } }
        Text { text: @tr("The queue is empty"); font-size: Theme.fs-lg; font-weight: 700; color: Theme.text; horizontal-alignment: center; }
        Text { text: @tr("Play an album or add tracks with “Add to queue”."); font-size: Theme.fs-sm; color: Theme.text2; horizontal-alignment: center; wrap: word-wrap; }
    }
}

export component QueuePanel inherits Rectangle {
    width: 360px;
    background: Theme.panel;
    Rectangle { x: 0; width: 1px; background: Theme.line; }
    VerticalLayout {
        padding: 16px;
        padding-top: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Text { text: @tr("Queue"); font-size: Theme.fs-xl; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
            if App.queue.length > 0: Button {
                text: @tr("Clear");
                clicked => { App.queue-clear(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.x;
                tooltip: @tr("Close");
                clicked => { App.queue-open = false; }
            }
        }
        if App.context-label != "": Text {
            text: App.context-label;
            font-size: Theme.fs-sm;
            color: Theme.text2;
            overflow: elide;
        }
        QueueList { vertical-stretch: 1; }
    }
}

// ------------------------------------------------------------------ now playing

component LyricsView inherits Rectangle {
    private property <length> target-y;
    // The source line gets its own strip below the scrolling lyrics.
    private property <bool> show-source: App.lyrics-source != "" && App.lyrics.length > 0;
    private property <length> source-h: root.show-source ? 28px : 0px;
    public function recenter() {
        if App.lyric-index >= 0 {
            flick.content-y = min(0, -(root.target-y - flick.height * 0.36));
        }
    }
    private property <bool> opening;
    Timer {
        interval: 60ms;
        running: root.opening;
        triggered => {
            root.opening = false;
            root.recenter();
        }
    }
    flick := Flickable {
        y: 0;
        height: root.height - root.source-h;
        content-height: col.preferred-height;
        animate content-y { duration: 420ms; easing: ease-out; }
        col := VerticalLayout {
            padding-top: 160px;
            padding-bottom: 320px;
            spacing: 14px;
            for l[i] in App.lyrics: Text {
                property <bool> is-current: App.lyrics-synced && i == App.lyric-index;
                changed is-current => {
                    if self.is-current {
                        root.target-y = self.y;
                        root.recenter();
                    }
                }
                // Opened mid-song: the current line is already set, so no
                // change fires; centre it once the layout is known.
                init => {
                    if self.is-current {
                        root.opening = true;
                    }
                }
                changed y => {
                    if self.is-current {
                        root.target-y = self.y;
                    }
                }
                text: l.text == "" ? "♪" : l.text;
                wrap: word-wrap;
                font-family: Theme.display;
                font-size: !App.lyrics-synced ? 20px : is-current ? 34px : 30px;
                animate font-size { duration: 260ms; easing: ease-out; }
                font-weight: 700;
                letter-spacing: -0.3px;
                color: !App.lyrics-synced ? #ffffffd9 : is-current ? #ffffff : i < App.lyric-index ? #ffffff59 : #ffffff73;
                animate color { duration: 300ms; }
                TouchArea {
                    enabled: App.lyrics-synced;
                    mouse-cursor: App.lyrics-synced ? pointer : default;
                    clicked => { App.seek(l.ms); }
                }
            }
        }
    }
    if App.lyrics.length == 0: VerticalLayout {
        alignment: center;
        spacing: 8px;
        HorizontalLayout { alignment: center; Icon { source: Icons.mic-vocal; size: 36px; tint: #ffffff66; } }
        Text {
            text: App.lyrics-status;
            font-size: Theme.fs-lg;
            font-weight: 600;
            color: #ffffffb3;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    if root.show-source: Text {
        x: 0;
        y: root.height - root.source-h + 8px;
        height: root.source-h - 8px;
        vertical-alignment: center;
        overflow: elide;
        width: root.width;
        text: App.lyrics-source;
        font-size: Theme.fs-xs;
        color: #ffffff66;
    }
}

component ChainView inherits VerticalLayout {
    spacing: 18px;
    alignment: start;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: !App.chain-known ? #ffffff66 : App.bitperfect ? Theme.good : Theme.warn;
        }
        Text {
            text: !App.chain-known ? @tr("Signal path") : App.bitperfect ? @tr("Bit-perfect") : @tr("Altered signal path");
            font-family: Theme.display;
            font-size: 30px;
            font-weight: 800;
            color: #ffffff;
        }
    }
    for hop[i] in App.chain: HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: 16px;
            Rectangle {
                x: 2px;
                y: 6px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                border-width: 2px;
                border-color: hop.state == 0 ? Theme.good : hop.state == 1 ? Theme.warn : #ffffff66;
            }
            // spine joining this hop to the next
            if i + 1 < App.chain.length: Rectangle {
                x: 7px;
                y: 20px;
                width: 2px;
                height: parent.height + 4px;
                background: (hop.state == 0 ? Theme.good : hop.state == 1 ? Theme.warn : #ffffff66).with-alpha(0.5);
            }
        }
        VerticalLayout {
            spacing: 2px;
            Text { text: hop.label; font-size: Theme.fs-sm; color: #ffffff99; }
            Text { text: hop.value; font-size: Theme.fs-xl; font-weight: 600; color: #ffffff; wrap: word-wrap; }
        }
    }
    Text {
        text: App.bitperfect ? @tr("Every sample reaches the DAC exactly as it is in the file.") : @tr("Volume below 100 %, ReplayGain, mute or a shared (non hw:) device alters the samples.");
        font-size: Theme.fs-md;
        color: #ffffffb3;
        wrap: word-wrap;
    }
}

export component NowPlayingView inherits Rectangle {
    callback close();
    background: #0b0b0d;
    clip: true;
    // blurred, darkened cover backdrop
    Image {
        width: 100%;
        height: 100%;
        source: App.backdrop;
        image-fit: cover;
        opacity: 0.9;
    }
    Rectangle { background: @linear-gradient(90deg, #000000b3 0%, #00000080 55%, #000000b3 100%); }
    Rectangle { background: Theme.accent.with-alpha(0.08); }
    TouchArea { }
    private property <length> cover-size: min(root.height - 190px, root.width * 0.36);
    HorizontalLayout {
        padding: 48px;
        padding-top: 72px;
        spacing: 56px;
        VerticalLayout {
            width: cover-size;
            alignment: center;
            spacing: 16px;
            Cover {
                width: cover-size;
                height: cover-size;
                radius: Theme.r-lg;
                source: App.cover-large.width > 0 ? App.cover-large : App.cover;
                placeholder: App.live ? Icons.radio : Icons.music;
                drop-shadow-blur: 40px;
                drop-shadow-offset-y: 18px;
                drop-shadow-color: #000000b3;
                // Clicking the large cover closes the view, like the small one.
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { App.now-playing-open = false; }
                }
            }
            Text {
                text: App.title;
                font-family: Theme.display;
                font-size: Theme.fs-2xl;
                font-weight: 800;
                color: #ffffff;
                wrap: word-wrap;
                max-height: 80px;
                overflow: elide;
            }
            Text {
                text: App.artist + (App.album != "" ? " — " + App.album : "");
                font-size: Theme.fs-lg;
                color: #ffffffb3;
                overflow: elide;
            }
            if App.quality != "": HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: !App.chain-known ? #ffffff66 : App.bitperfect ? Theme.good : Theme.warn;
                }
                Text {
                    text: (App.codec != "" ? App.codec + " · " : "") + App.quality + (App.bitperfect ? " · " + @tr("bit-perfect") : "");
                    font-size: Theme.fs-sm;
                    font-weight: 600;
                    color: #ffffffcc;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 18px;
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 34px;
                    width: tabs.preferred-width;
                    border-radius: 17px;
                    background: #ffffff1a;
                    tabs := HorizontalLayout {
                        padding: 3px;
                        spacing: 2px;
                        for t[i] in [@tr("Lyrics"), @tr("Queue"), @tr("Signal path")]: Rectangle {
                            width: tl.preferred-width + 28px;
                            border-radius: self.height / 2;
                            background: i == App.np-tab ? #ffffff : ttt.has-hover ? #ffffff1a : transparent;
                            tl := Text {
                                text: t;
                                font-size: Theme.fs-sm;
                                font-weight: 700;
                                color: i == App.np-tab ? #111111 : #ffffffcc;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ttt := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { App.np-tab = i; }
                            }
                        }
                    }
                }
            }
            if App.np-tab == 0: LyricsView { vertical-stretch: 1; }
            if App.np-tab == 1: QueueList { vertical-stretch: 1; }
            if App.np-tab == 2: ChainView { vertical-stretch: 1; }
        }
    }
    IconButton {
        x: 20px;
        y: 18px;
        icon: Icons.chevron-down;
        size: 38px;
        icon-size: 22px;
        tint: #ffffff;
        tooltip: @tr("Close");
        clicked => { root.close(); }
    }
}

// ------------------------------------------------------------------ menus

component MenuLine inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> danger;
    in property <bool> submenu;
    callback clicked();
    height: 34px;
    border-radius: Theme.r-sm;
    background: ta.has-hover ? Theme.hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        Icon { y: (parent.height - self.height) / 2; source: icon; size: 16px; tint: danger ? Theme.bad : Theme.text2; }
        Text { text: root.text; font-size: Theme.fs-base; color: danger ? Theme.bad : Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        if submenu: Icon { y: (parent.height - self.height) / 2; source: Icons.chevron-right; size: 14px; tint: Theme.text3; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ---- plugin actions (`Item.actions`), below the host's entries

component ItemActionLine inherits Rectangle {
    in property <ItemAction> action;
    // its tracks are being read
    in property <bool> busy;
    in property <bool> enabled: true;
    callback run(bool /* append */);
    height: 34px;
    border-radius: Theme.r-sm;
    background: enabled && ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: action.label;
    accessible-enabled: enabled;
    accessible-action-default => { if enabled { run(false); } }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.run(false); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: action.play ? 4px : 10px;
        spacing: 12px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: busy ? Icons.clock : action.play ? Icons.play : Icons.chevron-right;
            size: 16px;
            tint: enabled || busy ? Theme.text2 : Theme.text3;
        }
        Text {
            text: action.label;
            font-size: Theme.fs-base;
            color: enabled ? Theme.text : Theme.text3;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        // play actions: add to the queue instead of replacing it
        if action.play: IconButton {
            y: (parent.height - self.height) / 2;
            size: 26px;
            icon-size: 15px;
            icon: Icons.list-end;
            tooltip: @tr("Add to queue");
            enabled: root.enabled;
            clicked => { root.run(true); }
        }
    }
}

/// The plugin's own actions on the item under the menu, after a divider.
/// A "play" action keeps the menu open while its tracks are read.
component ItemActions inherits VerticalLayout {
    callback done();
    private property <bool> waiting;
    private property <int> w-busy: App.action-busy;
    changed w-busy => {
        if w-busy < 0 && waiting {
            waiting = false;
            root.done();
        }
    }
    if App.menu-actions.length > 0: Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
    for a[i] in App.menu-actions: ItemActionLine {
        action: a;
        busy: App.action-busy == i;
        enabled: App.action-busy < 0;
        run(append) => {
            App.item-action(i, append);
            if a.play && App.action-busy == i {
                root.waiting = true;
            } else {
                root.done();
            }
        }
    }
}

/// Context menu for tracks and albums, drawn as an overlay (window coords).
export component ContextMenu inherits Rectangle {
    in property <bool> is-album;
    in property <length> win-w;
    in property <length> win-h;
    callback dismiss();
    callback new-playlist-for(bool);
    private property <bool> playlists-mode;
    private property <length> menu-w: 236px;
    // Items from a plugin: no folder; their album and artist open when the
    // plugin tells enough (App.menu-album-nav / menu-artist-nav).
    private property <bool> plugin-list: is-album ? TrackMenu.album-plugin : TrackMenu.track-plugin;
    // an entry of the queue (TrackMenu.index is its id)
    private property <bool> queue-entry: !is-album && TrackMenu.list == "queue";
    private property <bool> can-radio: plugin-list && App.can-radio(is-album, TrackMenu.list, TrackMenu.index, TrackMenu.album-id);
    TouchArea {
        clicked => { root.dismiss(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.right { root.dismiss(); }
        }
    }
    panel := Rectangle {
        x: min(TrackMenu.x, root.win-w - root.menu-w - 8px);
        y: min(TrackMenu.y, root.win-h - self.height - 8px);
        width: menu-w;
        height: lay.preferred-height;
        border-radius: Theme.r-md;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line-strong;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000099;
        TouchArea { }
        lay := VerticalLayout {
            padding: 5px;
            spacing: 0;
            if !playlists-mode && queue-entry: VerticalLayout {
                if App.menu-album-nav: MenuLine { text: @tr("Go to album"); icon: Icons.disc-3; clicked => { act("album"); } }
                if App.menu-artist-nav: MenuLine { text: @tr("Go to artist"); icon: Icons.users-round; clicked => { act("artist"); } }
                MenuLine { text: @tr("Remove from the queue"); icon: Icons.x; clicked => { act("remove"); } }
                ItemActions { done => { root.close(); } }
            }
            if !playlists-mode && !queue-entry: VerticalLayout {
                MenuLine { text: @tr("Play"); icon: Icons.play; clicked => { act("play"); } }
                if is-album: MenuLine { text: @tr("Shuffle"); icon: Icons.shuffle; clicked => { act("shuffle"); } }
                MenuLine { text: @tr("Play next"); icon: Icons.list-plus; clicked => { act("next"); } }
                MenuLine { text: @tr("Add to queue"); icon: Icons.list-end; clicked => { act("queue"); } }
                MenuLine {
                    text: @tr("Add to playlist");
                    icon: Icons.list-music;
                    submenu: true;
                    clicked => {
                        App.playlist-targets(root.is-album ? 2 : 1);
                        root.playlists-mode = true;
                    }
                }
                // Plugin tracks, albums and artists whose plugin offers a radio.
                if can-radio: MenuLine { text: @tr("Start radio"); icon: Icons.radio; clicked => { act("radio"); } }
                Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                if !is-album && (!plugin-list || App.menu-album-nav): MenuLine { text: @tr("Go to album"); icon: Icons.disc-3; clicked => { act("album"); } }
                if !plugin-list || App.menu-artist-nav: MenuLine { text: @tr("Go to artist"); icon: Icons.users-round; clicked => { act("artist"); } }
                MenuLine { text: @tr("Favorite / unfavorite"); icon: Icons.heart; clicked => { act("fav"); } }
                if !plugin-list: MenuLine { text: @tr("Show in folder"); icon: Icons.folder-open; clicked => { act("folder"); } }
                if !is-album && TrackMenu.list == "playlist": MenuLine { text: @tr("Remove from playlist"); icon: Icons.trash; danger: true; clicked => { act("pl-remove"); } }
                // A plugin playlist the user owns: its entries are edited on the service.
                if !is-album && TrackMenu.list == "browse" && App.br-editable && App.br-can-move && TrackMenu.index > 0: MenuLine { text: @tr("Move up"); icon: Icons.chevron-up; clicked => { act("pl-up"); } }
                if !is-album && TrackMenu.list == "browse" && App.br-editable && App.br-can-move && (TrackMenu.index < App.br-tracks.length - 1 || App.br-more): MenuLine { text: @tr("Move down"); icon: Icons.chevron-down; clicked => { act("pl-down"); } }
                if !is-album && TrackMenu.list == "browse" && App.br-editable: MenuLine { text: @tr("Remove from playlist"); icon: Icons.trash; danger: true; clicked => { act("pl-remove"); } }
                // Keep last: the plugin's actions come after the host's.
                ItemActions { done => { root.close(); } }
            }
            if playlists-mode: VerticalLayout {
                MenuLine { text: @tr("Back"); icon: Icons.chevron-left; clicked => { root.playlists-mode = false; } }
                Rectangle { height: 9px; Rectangle { height: 1px; background: Theme.line; } }
                MenuLine { text: @tr("New playlist…"); icon: Icons.plus; clicked => { root.playlists-mode = false; root.new-playlist-for(root.is-album); } }
                // Local playlists, then the editable ones of the plugin the
                // items come from, under each source's name.
                for p in App.pl-targets: VerticalLayout {
                    if p.header: HorizontalLayout {
                        height: 28px;
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-bottom: 4px;
                        Text {
                            text: p.name.to-uppercase();
                            font-size: Theme.fs-xs;
                            font-weight: 700;
                            letter-spacing: 0.6px;
                            color: Theme.text3;
                            vertical-alignment: bottom;
                            overflow: elide;
                        }
                    }
                    if !p.header: MenuLine {
                        text: p.name;
                        icon: Icons.list-music;
                        clicked => { act("pl:" + p.key); }
                    }
                }
            }
        }
    }
    function close() {
        root.playlists-mode = false;
        root.dismiss();
    }
    function act(a: string) {
        root.playlists-mode = false;
        if root.is-album {
            App.album-action(TrackMenu.album-id, a);
        } else {
            App.track-action(TrackMenu.list, TrackMenu.index, a);
        }
        root.dismiss();
    }
}

// ------------------------------------------------------------------ dialogs

export component Dialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> confirm-text: @tr("OK");
    in property <bool> with-input;
    in property <bool> danger;
    in-out property <string> value;
    // A choice under the field (where a new playlist goes), shown when
    // there are several options.
    in property <string> choice-label;
    in property <[string]> choices;
    in-out property <int> choice;
    callback confirm(string);
    callback cancel();
    background: Theme.scrim;
    TouchArea { clicked => { root.cancel(); } }
    // The field, or Cancel when there is none (a confirmation: the keyboard
    // then has to move to the other button on purpose).
    public function focus-input() {
        if with-input { field.focus-field(); } else { cancel-button.focus(); }
    }
    Rectangle {
        width: 420px;
        height: lay.preferred-height;
        border-radius: Theme.r-lg;
        background: Theme.overlay;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 16px;
        drop-shadow-color: #000000b3;
        TouchArea { }
        lay := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text { text: root.title; font-size: Theme.fs-xl; font-weight: 700; color: Theme.text; }
            if root.body != "": Text { text: root.body; font-size: Theme.fs-md; color: Theme.text2; wrap: word-wrap; }
            field := TextField {
                visible: root.with-input;
                height: root.with-input ? 36px : 0;
                text <=> root.value;
                accepted(t) => { root.confirm(t); }
                escape => { root.cancel(); }
            }
            if root.choices.length > 1: VerticalLayout {
                spacing: 8px;
                Text { text: root.choice-label; font-size: Theme.fs-sm; font-weight: 600; color: Theme.text2; }
                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        options: root.choices;
                        selected <=> root.choice;
                        label: root.choice-label;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                padding-top: 6px;
                cancel-button := Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
                Button {
                    text: root.confirm-text;
                    primary: !root.danger;
                    danger: root.danger;
                    enabled: !root.with-input || root.value != "";
                    clicked => { root.confirm(root.value); }
                }
            }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 44px;
    width: min(lay.preferred-width, 560px);
    border-radius: 22px;
    background: Theme.overlay;
    border-width: 1px;
    border-color: error ? Theme.bad.with-alpha(0.6) : Theme.line-strong;
    drop-shadow-blur: 20px;
    drop-shadow-offset-y: 6px;
    drop-shadow-color: #00000099;
    lay := HorizontalLayout {
        padding-left: 16px;
        padding-right: 20px;
        spacing: 10px;
        Icon {
            y: (parent.height - self.height) / 2;
            source: error ? Icons.circle-alert : Icons.circle-check;
            size: 18px;
            tint: error ? Theme.bad : Theme.good;
        }
        Text { text: root.text; font-size: Theme.fs-base; font-weight: 500; color: Theme.text; vertical-alignment: center; overflow: elide; }
    }
}
