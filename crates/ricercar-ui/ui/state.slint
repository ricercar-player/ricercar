// Data exchanged with Rust, and the single global that carries it.

export enum Page { home, albums, album, artists, artist, tracks, genres, genre, favorites, playlist, radio, search, settings, browse, plugins }

export struct AlbumCard {
    id: string,
    title: string,
    artist: string,
    year: string,
    cover: image,
    ckey: string,
    hires: bool,
    fav: bool,
    // an album, playlist… of a plugin (opens its browse page)
    plugin: bool,
    // name of the plugin it comes from ("" for the local library)
    source: string,
}

export struct TrackRow {
    key: string,
    n: string,
    title: string,
    artist: string,
    album: string,
    album-id: string,
    dur: string,
    fav: bool,
    playing: bool,
    hires: bool,
    fmt: string,
    // non-empty on the first track of a disc of a multi-disc album
    disc: string,
    cover: image,
    ckey: string,
    plays: int,
    // plugin name ("" for the local library)
    source: string,
}

export struct ArtistCard {
    name: string,
    albums: int,
    tracks: int,
    cover: image,
    ckey: string,
    // plugins it also comes from, "Jellyfin · a streaming service" ("" local only)
    source: string,
}

export struct GenreCard {
    name: string,
    albums: int,
    tint: color,
}

export struct PlaylistItem {
    id: int,
    name: string,
    tracks: int,
    cover: image,
    ckey: string,
}

export struct QueueRow {
    id: int,
    // position in the whole queue (the model only holds what is shown)
    index: int,
    title: string,
    artist: string,
    dur: string,
    cover: image,
    ckey: string,
    current: bool,
    past: bool,
}

export struct LyricLine {
    text: string,
    ms: int,
}

export struct StationRow {
    uuid: string,
    name: string,
    sub: string,
    tags: string,
    cover: image,
    ckey: string,
    fav: bool,
}

export struct CapChip {
    label: string,
    ok: bool,
}

export struct DeviceRow {
    name: string,
    desc: string,
    hardware: bool,
    // a system mixer sits in the path (default / pipewire / pulse)
    shared: bool,
    selected: bool,
    // capabilities panel (hw: devices)
    expanded: bool,
    caps-known: bool,
    rates: [CapChip],
    formats: [CapChip],
    channels: string,
    // probing, in use, error…
    caps-status: string,
    // library albums this device cannot play natively, one per line
    lib-note: string,
}

// A declared source plugin, for the settings page.
export struct PluginRow {
    id: string,
    name: string,
    // "id · version"
    detail: string,
    status: string,
    // 0 fine, 1 starting / restarting, 2 needs attention
    state: int,
    enabled: bool,
    // has a sign-in, and is signed in
    auth: bool,
    signed-in: bool,
    // installed from the hub (removable, updatable)
    from-hub: bool,
    // the hub has another version
    update: bool,
}

// A plugin of the community hub.
export struct CatalogRow {
    id: string,
    name: string,
    // "by author · license · version"
    byline: string,
    description: string,
    // "browse · search · sign-in"
    caps: string,
    // 0 can be installed, 1 installed, 2 not for this computer
    state: int,
}

// Sidebar entry of a signed-in plugin: a header (its name) or a section.
export struct PluginNav {
    header: bool,
    title: string,
    // browse page argument
    arg: string,
    // folder | album | playlist | artist | track
    kind: string,
}

export struct ChainHop {
    label: string,
    value: string,
    // 0 = untouched, 1 = altered (not bit-perfect), 2 = unknown
    state: int,
}

export struct MenuEntry {
    id: string,
    label: string,
    icon: image,
    separator: bool,
    danger: bool,
}

export global App {
    // ---------------------------------------------------------------- navigation
    in-out property <Page> page: Page.home;
    in property <bool> can-back;
    in property <bool> can-forward;
    in-out property <bool> now-playing-open;
    in-out property <bool> queue-open;
    in-out property <int> np-tab; // 0 lyrics, 1 queue, 2 signal path
    callback navigate(Page, string);
    callback back();
    callback forward();

    // ---------------------------------------------------------------- player
    in property <bool> has-track;
    in property <bool> playing;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> album-id;
    in property <image> cover;
    in property <image> cover-large;
    in property <image> backdrop;
    in property <bool> live;
    in property <int> pos-ms;
    in property <int> dur-ms;
    in property <float> volume: 1;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <int> repeat; // 0 off, 1 all, 2 one
    in property <bool> fav;
    in property <bool> can-next;
    in property <string> quality; // "24/96", "16/44.1", "320k"
    in property <string> codec;
    in property <bool> hires;
    in property <bool> bitperfect;
    in property <bool> chain-known;
    in property <[ChainHop]> chain;
    // compact hops for the player bar: FLAC 24/96 → S24_LE → hw:1,0
    in property <[ChainHop]> chain-short;
    in property <string> device-label;
    in property <string> origin; // "", "UPnP", "Radio"
    in property <string> context-label;
    callback play-pause();
    callback next();
    callback prev();
    callback seek(int);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-fav();
    callback go-to-album();
    callback go-to-artist();

    // ---------------------------------------------------------------- queue
    // Upcoming items only; the current one is queue-now.
    in property <[QueueRow]> queue;
    in property <QueueRow> queue-now;
    in property <bool> queue-has-now;
    in property <int> queue-current;
    in property <string> queue-meta;
    callback queue-play(int);
    callback queue-remove(int);
    callback queue-move(int, int);
    callback queue-clear();

    // ---------------------------------------------------------------- lyrics
    in property <[LyricLine]> lyrics;
    in property <int> lyric-index: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-status;
    in property <string> lyrics-source;

    // ---------------------------------------------------------------- lists
    // Generic actions on a track list: list = "album", "artist-top", "tracks",
    // "fav", "search", "playlist", "home-played", "genre"
    callback track-activate(string, int);
    callback track-action(string, int, string);
    callback album-activate(string);
    callback album-action(string, string);
    callback artist-activate(string);
    in property <[MenuEntry]> track-menu;
    in property <[PlaylistItem]> playlists;

    // ---------------------------------------------------------------- home
    in property <string> greeting;
    in property <[AlbumCard]> home-played;
    in property <[AlbumCard]> home-added;
    in property <[AlbumCard]> home-top;
    in property <[TrackRow]> home-tracks;
    // last tracks played, plugins included
    in property <[TrackRow]> home-recent;
    in property <int> lib-tracks;
    in property <int> lib-albums;
    in property <int> lib-artists;
    in property <string> lib-duration;
    in property <int> lib-hires;
    in property <bool> scanning;
    in property <int> scan-done;
    in property <int> scan-total;
    callback shuffle-all();

    // ---------------------------------------------------------------- albums / artists / tracks / genres
    in property <[AlbumCard]> albums;
    in-out property <int> album-sort;
    in-out property <bool> albums-hires-only;
    callback albums-sort-changed();
    in property <[ArtistCard]> artists;
    in property <[TrackRow]> tracks;
    // Albums / Artists / Tracks: "All", "Library", then each plugin that
    // shares a library; shown when there is at least one.
    in property <[string]> library-sources;
    // local + plugin tracks on the Tracks page
    in property <int> tracks-total;
    in-out property <int> library-source;
    callback library-source-changed();
    // Virtualized lists report the rows on screen so covers load lazily.
    callback visible(string, int, int);
    in-out property <int> track-sort;
    callback tracks-sort-changed();
    in property <[GenreCard]> genres;

    // ---------------------------------------------------------------- album page
    in property <string> al-id;
    in property <string> al-title;
    in property <string> al-artist;
    in property <string> al-year;
    in property <string> al-genre;
    in property <int> al-count;
    in property <string> al-duration;
    in property <string> al-quality;
    in property <bool> al-hires;
    // the album comes from a plugin
    in property <bool> al-plugin;
    // a rate of this album is refused by the active output
    in property <bool> al-dac-unsupported;
    in property <bool> al-fav;
    in property <image> al-cover;
    in property <string> al-path;
    in property <[TrackRow]> al-tracks;
    in property <[AlbumCard]> al-more;

    // ---------------------------------------------------------------- artist page
    in property <string> ar-name;
    in property <int> ar-albums;
    in property <int> ar-tracks;
    in property <image> ar-cover;
    in property <[TrackRow]> ar-top;
    in property <[AlbumCard]> ar-own;
    in property <[AlbumCard]> ar-appears;

    // ---------------------------------------------------------------- genre / favorites / playlist
    in property <string> ge-name;
    in property <[AlbumCard]> ge-albums;
    in property <[AlbumCard]> fav-albums;
    in property <[TrackRow]> fav-tracks;
    in property <int> pl-id;
    in property <string> pl-name;
    in property <int> pl-count;
    in property <string> pl-duration;
    in property <image> pl-cover;
    in property <[TrackRow]> pl-tracks;
    callback playlist-create(string);
    callback playlist-rename(int, string);
    callback playlist-delete(int);
    callback playlist-play(int, bool);
    callback playlist-export(int);
    callback playlist-import();

    // ---------------------------------------------------------------- search
    in-out property <string> search-text;
    callback search(string);
    in property <[ArtistCard]> s-artists;
    in property <[AlbumCard]> s-albums;
    in property <[AlbumCard]> s-playlists;
    // search results shown: 0 all, 1 artists, 2 tracks, 3 albums, 4 playlists
    in-out property <int> search-kind;
    in property <[TrackRow]> s-tracks;

    // ---------------------------------------------------------------- radio
    in property <[StationRow]> stations;
    in property <[StationRow]> radio-favs;
    in property <[string]> radio-tags;
    in property <string> radio-status;
    in-out property <string> radio-query;
    callback radio-search(string);
    // typing in the field: debounced live search
    callback radio-edited(string);
    callback radio-tag(string);
    callback radio-play(string, int); // list ("results" | "favs"), index
    callback radio-fav(string, int);

    // ---------------------------------------------------------------- settings
    in property <[DeviceRow]> devices;
    callback select-device(string);
    callback refresh-devices();
    callback toggle-device-caps(string);
    in-out property <int> replaygain; // 0 off, 1 track, 2 album, 3 auto
    in-out property <float> preamp;
    callback settings-changed();
    // typing in a settings text field: saved after a pause
    callback text-setting-edited();
    in property <[string]> roots;
    callback add-root();
    callback remove-root(int);
    callback rescan();
    in-out property <bool> watch-library;
    in-out property <bool> restore-session;
    in-out property <string> renderer-name;
    in-out property <bool> renderer-enabled;
    in-out property <bool> server-enabled;
    in property <string> network-status;
    in-out property <string> lb-token;
    in property <string> lb-status;
    callback lb-save();
    callback lb-edited();
    in-out property <string> lastfm-key;
    in-out property <string> lastfm-secret;
    in property <string> lastfm-status;
    in property <bool> lastfm-pending;
    callback lastfm-connect();
    callback lastfm-finish();
    callback lastfm-disconnect();
    in-out property <bool> lyrics-online;
    in-out property <bool> covers-online;
    in-out property <bool> notifications;
    in-out property <bool> close-to-tray;
    in-out property <bool> theme-dark: true;
    // 0 system, 1 English, 2 French
    in-out property <int> ui-language;
    in-out property <bool> adaptive-colors: true;
    in-out property <int> accent-choice;
    in property <string> version;
    // scroll the settings page to its end (the screenshot tour shows About)
    in property <bool> settings-at-end;
    callback copy-report();
    callback open-logs();

    // ---------------------------------------------------------------- plugins
    in property <[PluginRow]> plugin-rows;
    callback plugin-toggle(string, bool);
    callback plugin-sign-in(string);
    callback plugin-sign-out(string);
    in property <[PluginNav]> plugin-nav;
    callback plugin-update(string);
    callback plugin-remove(string);
    // community catalogue (Plugins page)
    in-out property <bool> plugins-online;
    // installed plugins with an update in the catalogue
    in property <int> plugin-updates;
    // a newer ricercar release ("" none), its page
    in property <string> update-version;
    in property <string> update-url;
    callback update-open();
    callback update-dismiss();
    in-out property <bool> updates-online;
    in property <[CatalogRow]> catalog-rows;
    in property <string> catalog-status;
    in-out property <string> catalog-filter;
    callback catalog-filter-edited(string);
    callback catalog-install(string);
    callback catalog-open-repo(string);
    callback open-hub();
    // install / update confirmation
    in-out property <bool> install-open;
    in property <string> install-title;
    in property <string> install-body;
    in property <bool> install-busy;
    callback install-confirm();
    callback install-cancel();
    // sign-in dialog
    in-out property <bool> signin-open;
    in property <string> signin-title;
    in property <string> signin-url;
    in property <string> signin-instructions;
    in property <string> signin-status;
    in property <image> signin-qr;
    in property <bool> signin-busy;
    in property <bool> signin-expects-input;
    in-out property <string> signin-input;
    callback signin-open-browser();
    callback signin-complete(string);
    callback signin-cancel();
    // browse page (a plugin's list)
    in property <string> br-arg;
    in property <string> br-title;
    in property <string> br-sub;
    in property <[AlbumCard]> br-cards;
    in property <[TrackRow]> br-tracks;
    in property <bool> br-loading;
    in property <bool> br-more;
    in property <string> br-error;
    in property <bool> br-auth;
    callback br-load-more();
    callback br-sign-in();
    callback br-play(bool);
    // plugins still searching ("Jellyfin, Demo"), and their errors
    in property <string> search-pending;
    in property <string> search-errors;
    // a plugin track's URL is being fetched (shown after 300 ms)
    in property <bool> resolving;

    // ---------------------------------------------------------------- toasts
    in property <string> toast;
    in property <bool> toast-error;
    in property <int> toast-serial;

    // ---------------------------------------------------------------- misc
    callback open-url(string);
    callback show-in-folder(string);
    callback quit();
}
