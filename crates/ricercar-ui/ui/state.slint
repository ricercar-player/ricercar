// Data exchanged with Rust, and the single global that carries it.

export enum Page { home, albums, album, artists, artist, tracks, genres, genre, composers, composer, favorites, playlist, radio, search, settings, browse, plugins }

export struct AlbumCard {
    id: string,
    title: string,
    artist: string,
    year: string,
    cover: image,
    ckey: string,
    hires: bool,
    fav: bool,
    // an album, playlist… of a plugin (opens its browse page)
    plugin: bool,
    // name of the plugin it comes from ("" for the local library)
    source: string,
}

export struct TrackRow {
    key: string,
    n: string,
    title: string,
    artist: string,
    album: string,
    album-id: string,
    dur: string,
    fav: bool,
    playing: bool,
    hires: bool,
    fmt: string,
    // non-empty on the first track of a disc of a multi-disc album
    disc: string,
    cover: image,
    ckey: string,
    plays: int,
    // plugin name ("" for the local library)
    source: string,
}

export struct ArtistCard {
    name: string,
    albums: int,
    tracks: int,
    cover: image,
    ckey: string,
    // names of the plugins it also comes from, joined by " · " ("" local only)
    source: string,
}

export struct GenreCard {
    name: string,
    albums: int,
    tint: color,
}

export struct PlaylistItem {
    id: int,
    name: string,
    tracks: int,
    cover: image,
    ckey: string,
}

export struct QueueRow {
    id: int,
    // position in the whole queue (the model only holds what is shown)
    index: int,
    title: string,
    artist: string,
    dur: string,
    cover: image,
    ckey: string,
    current: bool,
    past: bool,
}

export struct LyricLine {
    text: string,
    ms: int,
    // The line times its words (see App.lyric-sung).
    karaoke: bool,
}

export struct StationRow {
    uuid: string,
    name: string,
    sub: string,
    tags: string,
    cover: image,
    ckey: string,
    fav: bool,
}

export struct CapChip {
    label: string,
    ok: bool,
}

export struct DeviceRow {
    name: string,
    desc: string,
    hardware: bool,
    // a system mixer sits in the path (default / pipewire / pulse)
    shared: bool,
    // the chosen PipeWire output is not connected right now
    absent: bool,
    selected: bool,
    // capabilities panel (hw: devices)
    expanded: bool,
    caps-known: bool,
    rates: [CapChip],
    formats: [CapChip],
    channels: string,
    // probing, in use, error…
    caps-status: string,
    // library albums this device cannot play natively, one per line
    lib-note: string,
    // DSD output (hw: devices): 0 convert to PCM, 1 DoP, 2 native
    dsd-choice: int,
    // the driver offers ALSA DSD formats: native is offered
    dsd-native: bool,
    // "DoP" / "NATIVE DSD" on the row when not converting
    dsd-badge: string,
}

// A declared source plugin, for the settings page.
export struct PluginRow {
    id: string,
    name: string,
    // "id · version · where it came from"
    detail: string,
    status: string,
    // 0 fine, 1 starting / restarting, 2 needs attention
    state: int,
    enabled: bool,
    // has a sign-in, and is signed in
    auth: bool,
    signed-in: bool,
    // installed by ricercar (hub, index, link or file)
    from-hub: bool,
    // the hub has another version
    update: bool,
    // declares settings, and is running (they can be changed)
    has-settings: bool,
    running: bool,
}

// A line of a plugin's settings dialog.
export struct SettingRow {
    // 0 section heading, 1 switch, 2 text, 3 number, 4 choice among a
    // few short options (segmented), 5 choice (drop-down list)
    kind: int,
    key: string,
    label: string,
    description: string,
    // takes effect after the plugin restarts
    restart: bool,
    on: bool,
    text: string,
    placeholder: string,
    // number: its unit
    unit: string,
    options: [string],
    selected: int,
    // why the last value was refused
    error: string,
}

// A plugin of the community hub.
export struct CatalogRow {
    id: string,
    name: string,
    // "by author · license · version"
    byline: string,
    description: string,
    // "browse · search · sign-in"
    caps: string,
    // 0 can be installed, 1 installed, 2 not for this computer
    state: int,
}

// A plugin offered by the setup assistant (setup.rs), from the catalogue.
export struct SetupPlugin {
    id: string,
    name: string,
    description: string,
    // installed before or by the assistant: shown checked, not editable
    installed: bool,
    checked: bool,
    // "Installing…", "Signed in", "Not signed in", the install error…
    status: string,
    failed: bool,
    // needs a sign-in it does not have yet, and is running
    can-sign-in: bool,
}

// A line of the setup summary.
export struct SetupLine {
    label: string,
    value: string,
}

// Sidebar entry of a signed-in plugin: a header (its name) or a section.
export struct PluginNav {
    header: bool,
    title: string,
    // browse page argument
    arg: string,
    // folder | album | playlist | artist | track
    kind: string,
    // plugin name (playlists in the Playlists list)
    source: string,
}

// A Home shelf from a plugin ("New releases" of a service)
export struct HomeShelf {
    title: string,
    source: string,
    cards: [AlbumCard],
}

// A shelf of a plugin's details ("Similar artists", "Top tracks"…): its
// items split by kind; `list` names its tracks for activation and menus.
export struct DetailShelf {
    title: string,
    list: string,
    cards: [AlbumCard],
    artists: [ArtistCard],
    tracks: [TrackRow],
}

// Part of a stream received so far, as fractions of its length.
export struct BufferedPart {
    start: float,
    end: float,
}

export struct ChainHop {
    label: string,
    value: string,
    // 0 = untouched, 1 = altered (not bit-perfect), 2 = unknown
    state: int,
}

// "Add to playlist" entry: a playlist, or a source's name heading its own
export struct PlaylistTarget {
    // after "pl:": a local playlist id, or a plugin playlist
    key: string,
    name: string,
    header: bool,
}

export struct MenuEntry {
    id: string,
    label: string,
    icon: image,
    separator: bool,
    danger: bool,
}

// An action a plugin offers on an item (`Item.actions`); the label is
// plain text from the plugin.
export struct ItemAction {
    label: string,
    // "play": its tracks go to the queue; otherwise it opens a page
    play: bool,
}

export global App {
    // ---------------------------------------------------------------- navigation
    in-out property <Page> page: Page.home;
    in property <bool> can-back;
    in property <bool> can-forward;
    in-out property <bool> now-playing-open;
    in-out property <bool> queue-open;
    // dragged from its right edge, kept in ui-state.json
    in-out property <length> sidebar-width: 240px;
    in-out property <int> np-tab; // 0 lyrics, 1 queue, 2 signal path
    callback navigate(Page, string);
    callback back();
    callback forward();

    // ---------------------------------------------------------------- player
    in property <bool> has-track;
    in property <bool> playing;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> album-id;
    in property <image> cover;
    in property <image> cover-large;
    in property <image> backdrop;
    in property <bool> live;
    in property <int> pos-ms;
    in property <int> dur-ms;
    in property <float> volume: 1;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <int> repeat; // 0 off, 1 all, 2 one
    in property <bool> fav;
    in property <bool> can-next;
    in property <string> quality; // "24/96", "16/44.1", "320k"
    in property <string> codec;
    in property <bool> hires;
    in property <bool> bitperfect;
    in property <bool> chain-known;
    in property <[ChainHop]> chain;
    // compact hops for the player bar: FLAC 24/96 → S24_LE → hw:1,0
    in property <[ChainHop]> chain-short;
    in property <string> device-label;
    in property <string> origin; // "", "UPnP", "Radio"
    in property <string> context-label;
    callback play-pause();
    callback next();
    callback prev();
    callback seek(int);
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-fav();
    callback go-to-album();
    callback go-to-artist();

    // ---------------------------------------------------------------- queue
    // Upcoming items only; the current one is queue-now.
    in property <[QueueRow]> queue;
    in property <QueueRow> queue-now;
    in property <bool> queue-has-now;
    in property <int> queue-current;
    in property <string> queue-meta;
    // continuous playback is asking the plugin for more tracks
    in property <bool> queue-radio-pending;
    callback queue-play(int);
    callback queue-remove(int);
    callback queue-move(int, int);
    callback queue-clear();

    // ---------------------------------------------------------------- lyrics
    in property <[LyricLine]> lyrics;
    in property <int> lyric-index: -1;
    // Start of the current line already sung, when it times its words.
    in property <string> lyric-sung;
    in property <bool> lyrics-synced;
    in property <string> lyrics-status;
    in property <string> lyrics-source;

    // ---------------------------------------------------------------- lists
    // Generic actions on a track list: list = "album", "artist-top", "tracks",
    // "fav", "search", "playlist", "home-played", "genre", "composer"
    callback track-activate(string, int);
    callback track-action(string, int, string);
    callback album-activate(string);
    callback album-action(string, string);
    callback artist-activate(string);
    in property <[MenuEntry]> track-menu;
    // The plugin item under the open context menu (set by `menu-opened`):
    // its own actions, shown below the host's, and whether "Go to album"
    // and "Go to artist" lead somewhere.
    callback menu-opened(bool /* album */);
    in property <[ItemAction]> menu-actions;
    in property <bool> menu-album-nav;
    in property <bool> menu-artist-nav;
    // the track under the menu has a composer ("Go to composer")
    in property <bool> menu-composer-nav;
    // An album menu (`menu-opened(true)`): it acts on a local playlist
    // (export), offers "Favorite / unfavorite", and renames or deletes the
    // playlist whose page is open.
    in property <bool> menu-local-playlist;
    in property <bool> menu-fav;
    in property <bool> menu-edit;
    // run menu-actions[i]; true: add to the queue instead of replacing it
    callback item-action(int, bool);
    // the "play" action whose tracks are being read, -1 when none
    in property <int> action-busy: -1;
    in property <[PlaylistItem]> playlists;

    // ---------------------------------------------------------------- home
    in property <string> greeting;
    in property <[AlbumCard]> home-played;
    in property <[AlbumCard]> home-added;
    in property <[AlbumCard]> home-top;
    in property <[TrackRow]> home-tracks;
    // last tracks played, plugins included
    in property <[TrackRow]> home-recent;
    in property <[HomeShelf]> home-shelves;
    // playlists of plugins with `library` (sidebar)
    in property <[PluginNav]> plugin-playlists;
    // a plugin's library is in the pages (Home is not "empty" then)
    in property <bool> plugin-library;
    // read the plugins' playlists (and the rest of their library) again
    callback plugin-libraries-reload();
    in property <int> lib-tracks;
    in property <int> lib-albums;
    in property <int> lib-artists;
    in property <string> lib-duration;
    in property <int> lib-hires;
    in property <bool> scanning;
    in property <int> scan-done;
    in property <int> scan-total;
    callback shuffle-all();

    // ---------------------------------------------------------------- albums / artists / tracks / genres
    in property <[AlbumCard]> albums;
    in-out property <int> album-sort;
    in-out property <bool> albums-hires-only;
    callback albums-sort-changed();
    in property <[ArtistCard]> artists;
    in property <[TrackRow]> tracks;
    // Albums / Artists / Tracks: "All", "Library", then each plugin that
    // shares a library; shown when there is at least one.
    in property <[string]> library-sources;
    // local + plugin tracks on the Tracks page
    in property <int> tracks-total;
    in-out property <int> library-source;
    callback library-source-changed();
    // Virtualized lists report the rows on screen so covers load lazily.
    callback visible(string, int, int);
    in-out property <int> track-sort;
    callback tracks-sort-changed();
    in property <[GenreCard]> genres;
    in property <[ArtistCard]> composers;

    // ---------------------------------------------------------------- album page
    in property <string> al-id;
    in property <string> al-title;
    in property <string> al-artist;
    in property <string> al-year;
    in property <string> al-genre;
    in property <int> al-count;
    in property <string> al-duration;
    in property <string> al-quality;
    in property <bool> al-hires;
    // the album comes from a plugin
    in property <bool> al-plugin;
    // plugin album: browse arguments of its artist and label ("" if none)
    in property <string> al-artist-arg;
    in property <string> al-label-arg;
    // a rate of this album is refused by the active output
    in property <bool> al-dac-unsupported;
    in property <bool> al-fav;
    in property <image> al-cover;
    in property <string> al-path;
    in property <[TrackRow]> al-tracks;
    in property <[AlbumCard]> al-more;
    // plugin details (item.details), filled after the page shows
    in property <string> al-facts;
    in property <[DetailShelf]> al-related;

    // ---------------------------------------------------------------- artist page
    in property <string> ar-name;
    in property <int> ar-albums;
    // Tracks on the artist page, -1 when a plugin album does not say.
    in property <int> ar-tracks;
    in property <image> ar-cover;
    in property <[TrackRow]> ar-top;
    in property <[AlbumCard]> ar-own;
    in property <[AlbumCard]> ar-appears;
    // Heart of a plugin artist whose favourite state is known.
    // its tracks are being gathered (Play, Shuffle, Add to queue)
    in property <bool> ar-busy;
    in property <bool> ar-fav-shown;
    in property <bool> ar-fav;
    callback ar-toggle-fav();
    // plugin details (item.details), filled after the page shows
    in property <string> ar-bio;
    in property <string> ar-bio-source;
    in property <string> ar-facts;
    in property <[DetailShelf]> ar-related;
    // a plugin that knows this artist can start a radio from it
    in property <bool> ar-radio;

    // ---------------------------------------------------------------- composer page
    in property <string> cp-name;
    in property <int> cp-albums;
    in property <int> cp-tracks;
    in property <[AlbumCard]> cp-album-list;
    // the composer's tracks; the first of each album carries its title
    in property <[TrackRow]> cp-works;

    // ---------------------------------------------------------------- radio
    // "Start radio" (plugins with `radio`): whether a menu's item can start
    // one (album menu, track list, track index, album id)…
    pure callback can-radio(bool, string, int, string) -> bool;
    // …and a radio being started.
    in property <bool> radio-busy;

    // ---------------------------------------------------------------- genre / favorites / playlist
    in property <string> ge-name;
    in property <[AlbumCard]> ge-albums;
    in property <[AlbumCard]> fav-albums;
    in property <[TrackRow]> fav-tracks;
    in property <int> pl-id;
    // its card id: what the header's menu and queue button act on
    in property <string> pl-card;
    in property <string> pl-name;
    in property <int> pl-count;
    in property <string> pl-duration;
    in property <image> pl-cover;
    in property <[TrackRow]> pl-tracks;
    // Display order of every playlist, local or from a plugin (see
    // `playlist_sort.rs`): playlist order, recently added, title, artist,
    // album, length.
    in-out property <int> playlist-sort;
    callback playlist-sort-changed();
    callback playlist-create(string);
    callback playlist-rename(int, string);
    callback playlist-delete(int);
    callback playlist-play(int, bool);
    callback playlist-export(int);
    callback playlist-import();
    // "Add to playlist" list and new-playlist locations for what a menu
    // acts on: 0 nothing (sidebar), 1 its track, 2 its album
    callback playlist-targets(int);
    in property <[PlaylistTarget]> pl-targets;
    // "Library", then the plugins that can take the new playlist
    in property <[string]> new-pl-locations;
    in-out property <int> new-pl-location;
    // location (1…), name, what to add then (0 nothing, 1 track, 2 album)
    callback plugin-playlist-create(int, string, int);

    // ---------------------------------------------------------------- search
    in-out property <string> search-text;
    callback search(string);
    in property <[ArtistCard]> s-artists;
    in property <[ArtistCard]> s-composers;
    in property <[AlbumCard]> s-albums;
    in property <[AlbumCard]> s-playlists;
    // search results shown: 0 all, 1 artists, 2 tracks, 3 albums, 4 playlists,
    // 5 composers
    in-out property <int> search-kind;
    // 0 everything, 1 my library (no catalogue search)
    in-out property <int> search-scope;
    // "Everything", "My library", then each signed-in plugin
    in property <[string]> search-scopes: [@tr("Everything"), @tr("My library")];
    callback search-scope-changed();
    in property <[TrackRow]> s-tracks;

    // ---------------------------------------------------------------- radio
    in property <[StationRow]> stations;
    in property <[StationRow]> radio-favs;
    in property <[string]> radio-tags;
    in property <string> radio-status;
    in-out property <string> radio-query;
    callback radio-search(string);
    // typing in the field: debounced live search
    callback radio-edited(string);
    callback radio-tag(string);
    callback radio-play(string, int); // list ("results" | "favs"), index
    callback radio-fav(string, int);

    // ---------------------------------------------------------------- settings
    in property <[DeviceRow]> devices;
    callback select-device(string);
    callback refresh-devices();
    callback toggle-device-caps(string);
    callback set-device-dsd(string, int); // device, 0 pcm / 1 dop / 2 native
    // setup assistant (setup.rs)
    in-out property <bool> setup-open;
    // 0 language, 1 library, 2 plugins, 3 output, 4 DAC, 5 volume, 6 summary
    in property <int> setup-step;
    in property <[string]> setup-folders;
    in property <[SetupPlugin]> setup-plugins;
    in property <bool> setup-plugins-loading;
    in property <string> setup-plugins-status; // offline, catalogue off, empty
    // plugins step: 0 choose, 1 confirm the downloads, 2 installing / done
    in property <int> setup-plugins-phase;
    in property <string> setup-plugins-confirm; // what will be installed, from where
    in property <bool> setup-plugins-busy;
    in property <[SetupLine]> setup-summary;
    in property <[DeviceRow]> setup-outputs; // hardware first
    in property <DeviceRow> setup-dev; // the chosen one, with its capabilities
    in property <string> setup-verdict; // "Plays up to 192 kHz / 32-bit natively"
    in property <string> setup-note; // shared output, unreadable device
    in-out property <bool> setup-fixed;
    callback setup-start();
    callback setup-language(int); // index in language-names
    callback setup-pick(string);
    callback setup-add-folder();
    callback setup-remove-folder(int);
    callback setup-plugin-check(string, bool);
    callback setup-next();
    callback setup-back();
    callback setup-skip();
    callback setup-finish();
    in-out property <int> replaygain; // 0 off, 1 track, 2 album, 3 auto
    in-out property <float> preamp;
    callback settings-changed();
    // typing in a settings text field: saved after a pause
    callback text-setting-edited();
    in property <[string]> roots;
    callback add-root();
    // typed folder path, when no folder picker (portal) is available
    in-out property <bool> root-path-open;
    in-out property <string> root-path;
    callback add-root-path(string);
    callback remove-root(int);
    callback rescan();
    in-out property <bool> watch-library;
    in-out property <bool> restore-session;
    in-out property <bool> continuous-playback;
    // [audio] fixed_volume: volume held at 100 %, volume controls disabled
    in-out property <bool> fixed-volume;
    in-out property <string> renderer-name;
    in-out property <bool> renderer-enabled;
    in-out property <bool> server-enabled;
    in property <string> network-status;
    // network interface choice: "All interfaces", then one per interface
    in property <[string]> net-ifaces;
    in-out property <int> net-iface;
    callback select-net-iface(int);
    in-out property <string> lb-token;
    in property <string> lb-status;
    callback lb-save();
    callback lb-edited();
    in-out property <string> lastfm-key;
    in-out property <string> lastfm-secret;
    in property <string> lastfm-status;
    in property <bool> lastfm-pending;
    callback lastfm-connect();
    callback lastfm-finish();
    callback lastfm-disconnect();
    in-out property <bool> lyrics-online;
    in-out property <bool> covers-online;
    in-out property <bool> notifications;
    in-out property <bool> close-to-tray;
    in-out property <bool> theme-dark: true;
    // Index in language-names: 0 system, then text::LANGUAGES in order.
    in-out property <int> ui-language;
    // Language names stay in their own language.
    out property <[string]> language-names: [@tr("System"), "English", "Français", "Deutsch", "Español", "Italiano", "日本語"];
    in-out property <bool> adaptive-colors: true;
    in-out property <bool> estimate-word-timing;
    in-out property <int> accent-choice;
    in property <string> version;
    // scroll the settings page to its end (the screenshot tour shows About)
    in property <bool> settings-at-end;
    callback copy-report();
    callback open-logs();

    // ---------------------------------------------------------------- plugins
    in property <[PluginRow]> plugin-rows;
    callback plugin-toggle(string, bool);
    callback plugin-sign-in(string);
    callback plugin-sign-out(string);
    in property <[PluginNav]> plugin-nav;
    callback plugin-update(string);
    callback plugin-remove(string);
    // settings a plugin declares (dialog)
    callback plugin-settings(string);
    in-out property <bool> psettings-open;
    in property <string> psettings-title;
    in property <string> psettings-note;
    in-out property <[SettingRow]> psettings-rows;
    callback psettings-bool(string, bool);
    callback psettings-text(string, string);
    callback psettings-choice(string, int);
    callback psettings-reset();
    callback psettings-close();
    // community catalogue (Plugins page)
    in-out property <bool> plugins-online;
    // installed plugins with an update in the catalogue
    in property <int> plugin-updates;
    // a newer ricercar release ("" none), its page
    in property <string> update-version;
    in property <string> update-url;
    callback update-open();
    callback update-dismiss();
    // the sidebar notice: go to Settings → About
    callback update-show();
    // About → Updates: 0 idle, 1 checking, 2 up to date, 3 available,
    // 4 installing, 5 installed (restart), 6 failed (update-error)
    in property <int> update-stage;
    // the newer release, even when its sidebar notice was closed
    in property <string> update-latest;
    // ricercar can install it itself (else: its release page)
    in property <bool> update-direct;
    in property <string> update-error;
    callback update-check();
    callback update-install();
    callback update-restart();
    in-out property <bool> updates-online;
    in property <[CatalogRow]> catalog-rows;
    in property <string> catalog-status;
    in-out property <string> catalog-filter;
    callback catalog-filter-edited(string);
    callback catalog-install(string);
    callback catalog-open-repo(string);
    callback open-hub();
    // other indexes the user added, read with the hub's
    in property <[string]> plugin-indexes;
    callback catalog-remove-index(string);
    // add a plugin from outside the hub
    callback plugin-add-file();
    in-out property <bool> link-open;
    in-out property <string> link-value;
    callback plugin-add-link(string);
    // install / update confirmation
    in-out property <bool> install-open;
    in property <string> install-title;
    in property <string> install-body;
    // confirm button label; empty for "Install"
    in property <string> install-action;
    in property <bool> install-busy;
    callback install-confirm();
    callback install-cancel();
    // sign-in dialog
    in-out property <bool> signin-open;
    in property <string> signin-title;
    in property <string> signin-url;
    in property <string> signin-instructions;
    in property <string> signin-status;
    in property <image> signin-qr;
    in property <bool> signin-busy;
    in property <bool> signin-expects-input;
    in-out property <string> signin-input;
    callback signin-open-browser();
    callback signin-complete(string);
    callback signin-cancel();
    // browse page (a plugin's list)
    in property <string> br-arg;
    in property <string> br-title;
    in property <string> br-sub;
    in property <[AlbumCard]> br-cards;
    in property <[TrackRow]> br-tracks;
    in property <bool> br-loading;
    in property <bool> br-more;
    in property <string> br-error;
    in property <bool> br-auth;
    // plugin details (item.details) of the listed item, filled after the page shows
    in property <string> br-bio;
    in property <string> br-bio-source;
    in property <string> br-facts;
    in property <[DetailShelf]> br-related;
    // card id of the item on the browse page (what its header's menu and
    // queue button act on), whether it has plugin actions, and its
    // favourite state when the plugin gives one
    in property <string> br-menu-id;
    in property <bool> br-actions;
    in property <bool> br-fav-shown;
    in property <bool> br-fav;
    callback br-load-more();
    callback br-sign-in();
    callback br-play(bool);
    // the list is a plugin playlist the user owns (rename, delete, remove
    // entries), and its entries can be moved
    in property <bool> br-editable;
    in property <bool> br-can-move;
    // the list is a plugin playlist: it can be sorted
    in property <bool> br-playlist;
    callback br-playlist-rename(string);
    callback br-playlist-delete();
    // plugins still searching ("Jellyfin, Demo"), and their errors
    in property <string> search-pending;
    in property <string> search-errors;
    // waiting for the track: its URL (plugin tracks) or the stream's data,
    // until it plays (shown after 300 ms)
    in property <bool> loading;
    // parts of the playing HTTP stream received so far (empty otherwise)
    in property <[BufferedPart]> buffered;

    // ---------------------------------------------------------------- toasts
    in property <string> toast;
    in property <bool> toast-error;
    in property <int> toast-serial;

    // ---------------------------------------------------------------- misc
    callback open-url(string);
    callback show-in-folder(string);
    callback quit();
}
